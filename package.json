{
  "name": "taiwan-policy-atlas",
  "description": "台灣政策圖譜：從你關心的議題，了解候選人的政策。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/site/build.mjs",
    "start": "node scripts/site/build.mjs && node scripts/site/serve.mjs",
    "serve": "node scripts/site/serve.mjs",
    "pipeline": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts .venv/bin/python -m pipeline",
    "test": "node --test \"tests/site/*.test.mjs\" \"tests/writing/*.test.mjs\" && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts:tests/pipeline .venv/bin/python -m unittest discover -s tests/pipeline -p 'test_*.py'",
    "check": "node scripts/site/imports.mjs && .venv/bin/black --check --quiet scripts/pipeline tests/pipeline",
    "lint": "node scripts/writing/lint.mjs",
    "test:browser": "node tests/site/browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "preact": "11.0.1"
  }
}
