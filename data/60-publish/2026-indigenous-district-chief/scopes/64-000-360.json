的「福利茂林」\n完善在地照顧網絡，讓弱勢有依靠、長者有尊嚴、孩子有照顧、家庭有支持。\n八、拼建設，完善基礎建設，打造觀光新風貌\n擘劃茂林里綜合運動場的計劃及興建、持續萬山里避難屋興建工程、加強各里部落安全建設、完成高132線易致災路段改善工程、規劃觀光大門新容貌、爭取多納打巴槓溫泉再造計劃、茂林里霧瓦納周邊親水休憩公園規劃。\n九、爭取原保地土地正義‒增設原住民土地維護所：\n落實原住民保留地管理及權利回復、加速國土計畫空間轉型、促進部落傳統文化永續。","unresolved":0}],"specificity":[{"claim":"64-000-360-1-001","criterion":"conditions","evidence":null,"id":"64-000-360-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-001","criterion":"funding","evidence":null,"id":"64-000-360-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-001","criterion":"implementation","evidence":null,"id":"64-000-360-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-001","criterion":"instrument","evidence":"活化在地產業、發展地方創生","id":"64-000-360-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「活化在地產業、發展地方創生」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"64-000-360-1-001","criterion":"quantity","evidence":null,"id":"64-000-360-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-001","criterion":"schedule","evidence":null,"id":"64-000-360-1-001-schedule","level":"unstated","method":"模型判讀","reason":"原文沒有寫出時間安排","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-001","criterion":"target","evidence":"青年","id":"64-000-360-1-001-target","level":"partial","method":"模型判讀","reason":"原文寫出「青年」，符合部分明示：指出受益或受規範的群體、地域或機構類別","review_status":"未經獨立複評","value":0.5},{"claim":"64-000-360-1-002","criterion":"conditions","evidence":null,"id":"64-000-360-1-002-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"64-000-360-1-002","criterion":"funding","evidence":"整合