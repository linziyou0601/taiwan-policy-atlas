olved":0},{"document":"bulletin-09-020-060","entity":"2026-township-mayor:09-020-060:2","id":"09-020-060-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄為文字層，對照渲染圖核對；八句不編號，各占一行；OCR 比對無差異","review_status":"未經獨立複評","text":"守護烏坵燈塔，振興紫菜產業。\n烏坵老人安養計劃，返鄉人才培育計劃。\n小坵衛浴廁所整建，家家戶戶有水有電。\n搶救雙玉井，維護水源，建村落水塔。\n尊重文化資產，老石屋修繕計劃之推動。\n以軍旅文化，強化島嶼生機。\n打造為民服務的鄉公所，配合鄉代會齊力救家鄉。\n島際交通改善，善待回鄉的烏坵人。","unresolved":0},{"document":"bulletin-09-020-060","entity":"2026-township-mayor:09-020-060:3","id":"09-020-060-3-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄為文字層，對照渲染圖核對；OCR 比對無差異","review_status":"未經獨立複評","text":"一、爭取中央與縣府資源，落實地方建設。\n二、關懷居民身心健康，加強醫療照護與長照服務。\n三、改善道路照明及公共設施，提升居住安全。","unresolved":0}],"specificity":[{"claim":"09-020-060-1-001","criterion":"conditions","evidence":null,"id":"09-020-060-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"09-020-060-1-001","criterion":"funding","evidence":null,"id":"09-020-060-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"09-020-060-1-001","criterion":"implementation","evidence":null,"id":"09-020-060-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"09-020-060-1-001","criterion":"instrument","evidence":"改善全鄉道路","id":"09-020-060-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「改善全鄉道路」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"09-020-060-1-001","criterion":"quantity","evidence":null,"id":"09-020-060-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"09-020-060-1-001","criterion":"schedule","evidence":null,"id":"09-020-060-1-001-schedule","level":"unstated","method":"模型判讀","reason":"原文沒有寫出時間安排","review_status":"未經獨立複評","value":0.0},{"claim":"09-020-060-1-00