on":1,"reason":"原文只寫振興觀光產業的方向或目標，沒有寫出做法，判為支持","review_status":"未經獨立複評","stance":"stance.support","stance_value":1.0},{"allocation":1.0,"claim":"10-010-030-2-003","evidence":null,"facet":"welfare.assistance","id":"10-010-030-2-003-m1","method":"模型判讀","question":null,"question_version":null,"reason":"原文只寫爭取弱勢福利，題目問的是簡化申請程序，方向與原文無關，題目寫 -，只計入議題分布","review_status":"未經獨立複評","stance":null,"stance_value":null}],"ocr":{},"passages":[{"document":"bulletin-10-010-030","entity":"2026-township-mayor:10-010-030:1","id":"10-010-030-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄有可用的文字層，對照渲染圖核對每一行；八條依編號每條一行，折行處接回","review_status":"未經獨立複評","text":"1.爭取172線及157線道路拓寬工程；改善對外交通問題。\n2.爭取恢復布袋海關及檢疫所重新設立，再創小上海榮景。\n3.爭取布袋都市計畫內擴大工業用地編定，以利工廠設立，增加鎮民就業。\n4.爭取農、漁民辦理推廣各精緻農業、肥料、農藥、漁網等設施和漁船用油補助，降低農、漁投資成本，提高工作收入。\n5.爭取布袋鎮轄內上海路往東至東港里道路開闢及爭取台17線全國加油站旁至新厝北連外道路開闢，以擴大市區範圍，建立港灣城市。\n6.爭取布袋第三漁港設立情人碼頭及黃金海岸等設施，推動地方觀光。\n7.爭取提高各項社會福利(含低收、殘障、老人、婦女、幼兒在內)等補助政策，以照顧鎮內弱勢團體鎮民。\n8.爭取普發3000元。","unresolved":0},{"document":"bulletin-10-010-030","entity":"2026-township-mayor:10-010-030:2","id":"10-010-030-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄有可用的文字層，對照渲染圖核對每一行；五條依編號每條一行","review_status":"未經獨立複評","text":"1.地方基礎建設持續爭取\n2.解決抽水站的增設及更新\n3.打造觀光大鎮\n4.努力爭取弱勢福利\n5.讓布袋逐步邁向美好的未來","unresolved":0}],"specificity":[{"claim":"10-010-030-1-001","criterion":"conditions","evidence":null,"id":"10-010-030-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-030-1-001","criterion":"funding","evidence":null,"id":"10-010-030-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-030-1-001","criterion":"implementation","evidence":null,"id":"10-010-030-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-030-1-001","criterion":"instrument",