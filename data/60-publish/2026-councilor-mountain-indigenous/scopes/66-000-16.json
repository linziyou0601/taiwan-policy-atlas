853839849965,"text":"4. 青創孵化與數位轉型","width":0.28806166999084126,"x":0.014399772698184193,"y":0.42925402469460017},{"confidence":0.3,"height":0.05132883885863482,"text":"5.綠色碳權與冷鏈電商","width":0.28800839354089425,"x":0.014432672486690803,"y":0.5589008962546913},{"confidence":0.3,"height":0.054189077000709074,"text":"6. 居住正義與就業保障","width":0.2894778063068282,"x":0.014415985532317252,"y":0.6842818253243043},{"confidence":0.3,"height":0.052191494984232034,"text":"7. 部落主體與產業觀光","width":0.2894644871943415,"x":0.014421755010640774,"y":0.8119650261223075}],"tool_sha256":"3985c007dc2b776ead4aae1c0750f7781bc0e14d19212af7066c91ae9a0af7df"}},"passages":[{"document":"bulletin-66-000","entity":"2026-councilor-mountain-indigenous:66-000-16:1","id":"66-000-16-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"公報第 1 頁，以文字層為準並對照渲染圖；一到七條各占一行","review_status":"未經獨立複評","text":"一、守護土地權益：推動原保地、建築、民宿合法化單一窗口，解決族人土地與居住困境。\n二、強化原鄉建設：改善道路、供水、通訊、交通及防災，建立安全韌性家園。\n三、完善醫療照顧：強化偏鄉醫療、長照、托育、幸福巴士及長者照顧。\n四、支持青年返鄉：推動原民就業、創業、智慧農業、觀光及部落產業，創造在地工作。\n五、深化教育文化：落實族語、民族教育、文化傳承及原民學生教育支持。\n六、照顧都會族人：強化就業、住宅、長照、婦幼及文化服務。\n七、專業問政、服務到底：監督預算、追蹤列管族人陳情，讓政策走進部落、讓族人有感。","unresolved":0},{"document":"bulletin-66-000","entity":"2026-councilor-mountain-indigenous:66-000-16:2","id":"66-000-16-2-p1","image":"bulletin-66-000-p1-2","method":"模型判讀","ocr_check":{"agreement":1.0,"unmatched":[]},"page":1,"reason":"公報第 1 頁，政見欄整個是一張嵌入影像，照影像轉錄；1. 到 7. 各占一行，編號後的空白刪除","review_status":"未經獨立複評","text":"1.傾聽民意與權益實踐\n2.文化傳承與教育賦權\n3.社群照護與偏鄉交通\n4.青創孵化與數位轉型\n5.綠色碳權與冷鏈電商\n6.居住正義與就業保障\n7.部落主體與產業觀光","unresolved":0}],"specificity":[{"claim":"66-000-16-1-001","criterion":"conditions","evidence":null,"id":"66-000-16-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"66-000-16-1-001","criterion":"funding","evidence":null,"id":"66-000-16-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"6