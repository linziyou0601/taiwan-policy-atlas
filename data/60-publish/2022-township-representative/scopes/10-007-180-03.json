ntity":"2022-township-representative:10-007-180-03:1","id":"10-007-180-03-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄是文字層，以文字層為起點逐行對照渲染圖核對，一致。共三條，以國字編號，由上而下各占一行。文字層把經歷欄的「第20、21屆鄉民代表」與第一條排在同一行，轉錄時略去。","review_status":"未經獨立複評","text":"一、加強農業產銷輔導，提高農民收益。\n二、爭取基層建設，促進地方繁榮。\n三、發展社區經營，關懷弱勢照顧老幼婦孺。","unresolved":0},{"document":"bulletin-10-007-180-03","entity":"2022-township-representative:10-007-180-03:2","id":"10-007-180-03-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄是文字層，以文字層為起點逐行對照渲染圖核對，一致。共三條，由上而下各占一行。","review_status":"未經獨立複評","text":"1、為民喉舌，積極反映民意，以民意為主。\n2、竭誠為民服務，以理性、負責、熱忱態度監督鄉政。\n3、加強關懷老人、殘障、婦幼等弱勢團體，並爭取福利。","unresolved":0},{"document":"bulletin-10-007-180-03","entity":"2022-township-representative:10-007-180-03:3","id":"10-007-180-03-3-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見欄是文字層，以文字層為起點逐行對照渲染圖核對，一致。共三條，條末沒有標點，由上而下各占一行。政見欄只寫監督、服務與爭取建設或福利，沒有寫出項目，沒有主張","review_status":"未經獨立複評","text":"1.積極爭取建設，為民服務\n2.監督鄉政，為民把關\n3.傾聽民意，用心服務","unresolved":0}],"specificity":[{"claim":"10-007-180-03-1-001","criterion":"conditions","evidence":null,"id":"10-007-180-03-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-180-03-1-001","criterion":"funding","evidence":null,"id":"10-007-180-03-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-180-03-1-001","criterion":"implementation","evidence":null,"id":"10-007-180-03-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-180-03-1-001","criterion":"instrument","evidence":"產銷輔導","id":"10-007-180-03-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「產銷輔導」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"10-007-180-03-1-001","criterion":"quantity","evidence":null,"id":