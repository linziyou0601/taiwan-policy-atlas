2644,"y":0.7318866806909425},{"confidence":0.3,"height":0.0636347252140732,"text":"拼未來","width":0.07175856482084875,"x":0.7824346720482606,"y":0.7423340742477822},{"confidence":0.5,"height":0.04894967185489929,"text":"強化民防力量，串連民防前線，守護家園安全！","width":0.3577298727117344,"x":0.1961361151461898,"y":0.7805674598102075},{"confidence":1,"height":0.08531579267917322,"text":"馬公市民代表","width":0.17286029012005477,"x":0.5385388194671141,"y":0.8013651704053434},{"confidence":1,"height":0.08768006418008945,"text":"懇請支持謝佑康","width":0.20285281462255722,"x":0.5402358451361443,"y":0.8636557347350122},{"confidence":1,"height":0.04002684630824205,"text":"更多政策，歡迎掃描佑康的粉絲專頁！","width":0.2618466387258699,"x":0.2513353036682844,"y":0.9479019421017534}],"tool_sha256":"3985c007dc2b776ead4aae1c0750f7781bc0e14d19212af7066c91ae9a0af7df"}},"passages":[{"document":"bulletin-10-016-010","entity":"2022-township-representative:10-016-010-01:1","id":"10-016-010-01-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"頁面沒有文字層，照渲染圖轉錄。真照圖上字形。政見欄只寫監督市政、為民服務與問政的態度，沒有主張","review_status":"未經獨立複評","text":"監督市政、為民服務、真情真意、勇於承擔","unresolved":0},{"document":"bulletin-10-016-010","entity":"2022-township-representative:10-016-010-01:2","id":"10-016-010-01-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"頁面沒有文字層，照渲染圖轉錄。第 5 條的折行接回","review_status":"未經獨立複評","text":"1.監督市政預算編列執行是否落實，不浪費市民的納稅錢，盡職代表工作。\n2.監督基礎建設工程品質，提升市區環境美感。\n3.督促提升公共安全，活化市區閒置空間。\n4.為民揭弊，為弱勢發聲，願意接納意見，隨時找得到的市代表。\n5.堅持乾淨選舉，四不一沒有：不插旗、不廣播、不放鞭炮、不開美肌修圖欺騙選民、沒有造勢活動喧囂，只有街坊一一拜訪，馬公市公共事務的監督需要你我一同參與，正仁有心為民喉舌，監督市政守護家園，馬公需要正仁，正仁給大家正能量！","unresolved":0},{"document":"bulletin-10-016-010","entity":"2022-township-representative:10-016-010-01:3","id":"10-016-010-01-3-p1","image":"bulletin-10-016-010-p1-3","method":"模型判讀","ocr_check":{"agreement":0.9768,"unmatched":[]},"page":1,"reason":"政見欄整個是一張影像，照渲染圖轉錄。勾選框照形狀寫成☑；條目錯落排成兩欄，依欄序先左欄後右欄；印章「安心生活」下的小字解析度不足而略過；拚照圖上字形；人物相片、QR code、政黨標誌與插圖略過，標語、對話框與 QR code 旁的說明照錄；OCR 重合度 0.98，沒有未對上的行，整段對照影像一致；「安心生活」印章下方一行小字解析度不足，標〔?〕","review_status":"未經獨立複評","text":"佑康不會停下努力的腳步，\n三甲不能再空轉四年！\n安心生活\n〔?〕\n讓市民安心生活，過去沒有人肯做，現在謝佑康來做：\n☑完善馬公市育幼政策，推廣月子中心產業鏈，安心生活，就是要讓市民安心生、安心活！\n☑爭取城隍廟旁停車場為基地，興建媽宮城聯合活動中心，提供三甲六社區市民優質聚會場所！\n☑針對城區所有無障礙設施通盤檢討、落實人行道優化，照顧行人與店家！\n☑推動社區參與式預算，重建馬公市財政紀律！\n☑建設「民權徒步商圈」、推動民權立體停車場！\n☑強化民防力量，串連民防前線，守護家園安全！\n☑串聯三甲各商圈，打造老城區一日徒步旅遊帶，全力協助業者發展，傳承三甲文化、振興商圈！\n☑推動老城新生，打造智慧城市！民生優先！文化優先！銀髮優先！\n“清白選！認真做！”\n顧家鄉 拚未來\n馬公市民代表\n懇請支持謝佑康\n更多政策，歡迎掃描佑康的粉絲專頁！","unresolved":1},{"document":"bulletin-10-016-010","entity":"2022-township-representative:10-016-010-01:4","id":"10-016-010-01-4-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"頁面沒有文字層，照渲染圖轉錄。編號後的頓號壓縮在數字右下角，照錄為「一、」。政見欄第一項監督市政是問政態度，第二項協助各里與社區推動建設與活動是概括語，第三至五項協助團體辦理公益活動、成立縣市連線服務與配合志工團體服務是參選人自己的服務清單，整份不建立主張，沒有主張","review_status":"未經獨立複評","text":"一、監督市政、強化市政功能，提升服務市民品質。\n二、協助各里、社區推動各項建設與活動。\n三、協助婦女、弱勢團體，辦理各項公益活動。\n四、成立縣、市連線服務。\n五、配合各志工團體從事各項服務工作。","unresolved":0}],"specificity":[{"claim":"10-016-010-01-2-001","criterion":"conditions","evidence":null,"id":"10-016-010-01-2-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-016-010-01-2-001","criterion":"funding","evidence":null,"id":"10-016-010-01-2-001-funding","level":"not-applicable","method":"模型判讀","reason":"代表會審查與監督預算不需要另編經費","review_status":"未經獨立複評","value":null},{"claim":"10-016-010-01-2-001","criterion":"implementation","evidence":null,"id":"10-016-010-01-2-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-016-010-01-2-001","criterion":"instrument","evidence":null,"id":"10-016-010-01-2-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只寫出目標或方向，沒有寫出採用的措施","review_status":"未經獨立複評","value":0.0},{"claim":"10-016-010-01-2-001","criterion":"quantity","evidence":null,"id":"10-016-010-01-2-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評",