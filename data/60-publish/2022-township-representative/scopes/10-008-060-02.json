ocation":1.0,"claim":"10-008-060-02-2-007","evidence":"請求農政機構與公所積極來輔導農民特產策略行銷","facet":"regional.agriculture.marketing","id":"10-008-060-02-2-007-m1","method":"模型判讀","question":"q.regional.agriculture.marketing","question_version":1,"reason":"原文推廣行銷農產品或健全產銷，方向與協助農產品行銷相同，但沒有寫出品牌、加工、冷鏈或通路等做法，判為支持","review_status":"未經獨立複評","stance":"stance.support","stance_value":1.0}],"ocr":{},"passages":[{"document":"bulletin-10-008-060-02","entity":"2022-township-representative:10-008-060-02:1","id":"10-008-060-02-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見來自公報文字層，對照渲染圖核對，政見欄只有一行。政見欄是服務與問政的態度，沒有寫出政策內容，沒有主張","review_status":"未經獨立複評","text":"為民服務","unresolved":0},{"document":"bulletin-10-008-060-02","entity":"2022-township-representative:10-008-060-02:2","id":"10-008-060-02-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見來自公報文字層，對照渲染圖逐行核對，八條依編號各占一行，縮排的續行接回原條。","review_status":"未經獨立複評","text":"1.爭取變電所回饋金合理的善用，監督落實每筆使用的價值性。\n2.尋求政府其它新資源，開發村民更多福利。\n3.提高並落實各村環境衛生消毒、空氣品質保護村民健康。\n4.協助改進各村因大雨路面積水的問題。\n5.規劃律師來各村社區做免費的民刑事上疑問。\n6.聯繫善用更多善心團體來加強幫助老人、弱勢、政府補助邊緣人。\n7.請求農政機構與公所積極來輔導農民特產策略行銷。\n8.以理性、負責的心為民服務，不讓代表職責像空缺。","unresolved":0}],"specificity":[{"claim":"10-008-060-02-2-001","criterion":"conditions","evidence":null,"id":"10-008-060-02-2-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-060-02-2-001","criterion":"funding","evidence":"回饋金","id":"10-008-060-02-2-001-funding","level":"partial","method":"模型判讀","reason":"原文寫出「回饋金」，符合部分明示：提及預算、基金或撥補","review_status":"未經獨立複評","value":0.5},{"claim":"10-008-060-02-2-001","criterion":"implementation","evidence":null,"id":"10-008-060-02-2-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-060-02-2-001","criterion":"instrument","evidence":null,"id":"10-008-060-02-2-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只