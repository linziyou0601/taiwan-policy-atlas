eview_status":"未經獨立複評","text":"本持為民服務﹑增進村民福祉﹑建造宜居環境﹑監督鄉政﹑提高行政效率﹑爭取地方建設。\n短期目標：村內道路修繕﹑燈桿﹑溝渠河道疏通﹑修繕。\n長期目標：推動治山防洪計劃。\n建造造橋休閒環境。","unresolved":0},{"document":"bulletin-10-005-150","entity":"2022-township-representative:10-005-150-01:2","id":"10-005-150-01-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"依文字層轉錄，對照渲染圖確認；6 條各占一行。文字層半形字元前夾有 NUL 字元，刪除；逗號、冒號、括號與刪節點依文字層為半形，頓號是 ﹑（U+FE51）照錄","review_status":"未經獨立複評","text":"1.重視老人福利,推動長照服務\n2.照顧弱勢族群,設置關懷據點\n3.加強農村建設,樂活農村社區\n4.加強幼青教育,設置課輔據點\n5.自治條例機制,完善造橋權益(嫌惡設施,如:基地台﹑廢棄物掩埋場....等。)\n6.強化世代連結,樂活農村社區","unresolved":0},{"document":"bulletin-10-005-150","entity":"2022-township-representative:10-005-150-01:3","id":"10-005-150-01-3-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"依文字層轉錄，對照渲染圖確認；2 句各占一行。政見欄只寫監督、服務與爭取建設或福利，沒有寫出項目，沒有主張","review_status":"未經獨立複評","text":"積極為民服務。\n爭取各項經費建設地方。","unresolved":0}],"specificity":[{"claim":"10-005-150-01-1-001","criterion":"conditions","evidence":null,"id":"10-005-150-01-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-005-150-01-1-001","criterion":"funding","evidence":null,"id":"10-005-150-01-1-001-funding","level":"not-applicable","method":"模型判讀","reason":"提升行政效率不需要另編經費","review_status":"未經獨立複評","value":null},{"claim":"10-005-150-01-1-001","criterion":"implementation","evidence":null,"id":"10-005-150-01-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-005-150-01-1-001","criterion":"instrument","evidence":null,"id":"10-005-150-01-1-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只寫出目標或方向，沒有寫出採用的措施","review_status":"未經獨立複評","value":0.0},{"claim":"10-005-150-01-1-001","criterion":"quantity","evidence":null,"id":"10-005-150-01-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-005-150-01-1-001","c