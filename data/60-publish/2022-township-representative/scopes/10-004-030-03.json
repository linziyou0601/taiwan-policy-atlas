4-030","entity":"2022-township-representative:10-004-030-03:3","id":"10-004-030-03-3-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照 8 px/pt 渲染圖確認行序；第 4、5 條縮排續行接回該條；65 與 500 兩側的空白依規則刪除","review_status":"未經獨立複評","text":"一、爭取仰德社區內公園重建。\n二、爭取新埔鎮內年滿65歲以上，鎮公所每月補助每人500元健保費。\n三、爭取寶石里、內立里里民活動中心重建。\n四、爭取文山國小附設幼稚園，並實施雙語教學，讓小朋友有更好的學習環境。\n五、爭取更多的活動費和設備費，補助各社區發展協會，以利於照顧社區老人福利。","unresolved":0}],"specificity":[{"claim":"10-004-030-03-1-001","criterion":"conditions","evidence":null,"id":"10-004-030-03-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-004-030-03-1-001","criterion":"funding","evidence":"公所預算","id":"10-004-030-03-1-001-funding","level":"partial","method":"模型判讀","reason":"原文寫出「公所預算」，符合部分明示：提及預算、基金或撥補","review_status":"未經獨立複評","value":0.5},{"claim":"10-004-030-03-1-001","criterion":"implementation","evidence":"公所","id":"10-004-030-03-1-001-implementation","level":"partial","method":"模型判讀","reason":"原文寫出「公所」，符合部分明示：提出具名制度、法案或機關","review_status":"未經獨立複評","value":0.5},{"claim":"10-004-030-03-1-001","criterion":"instrument","evidence":"爭取公所預算","id":"10-004-030-03-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「爭取公所預算」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"10-004-030-03-1-001","criterion":"quantity","evidence":null,"id":"10-004-030-03-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-004-030-03-1-001","criterion":"schedule","evidence":null,"id":"10-004-030-03-1-001-schedule","level":"unstated","method":"模型判讀","reason":"原文沒有寫出時間安排","review_status":"未經獨立複評","value":0.0},{"claim":"10-004-030-03-1-001","criterion":"target","evidence":"老人","id":"10-004-030-03-1-001-target","level":"partial","method":"模型判讀","reason":"原文寫出「老人」，符合部分明示：指出受益或受規範的群體、地域或機構類別","review_status":"未經獨立複評","value":0.5},{"claim":"10-004-030-03-1-002","criterion":"conditions","