wnship-representative:10-010-080-02:5","id":"10-010-080-02-5-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對；公報同頁含鄉長與村長候選人，只轉錄代表第2選舉區欄；因欄寬折行接回。政見欄只寫繁榮地方經濟、促進村里基層建設、為民服務與爭取人民福利，沒有寫出建設項目或群體，沒有主張","review_status":"未經獨立複評","text":"繁榮地方經濟，促進村里基層建設，全心為民服務，積極爭取人民福利。","unresolved":0},{"document":"bulletin-10-010-080-02","entity":"2022-township-representative:10-010-080-02:6","id":"10-010-080-02-6-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對；公報同頁含鄉長與村長候選人，只轉錄代表第2選舉區欄","review_status":"未經獨立複評","text":"1.爭取建設創新未來\n2.改善社區環境衛生","unresolved":0},{"document":"bulletin-10-010-080-02","entity":"2022-township-representative:10-010-080-02:7","id":"10-010-080-02-7-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對；公報同頁含鄉長與村長候選人，只轉錄代表第2選舉區欄","review_status":"未經獨立複評","text":"1.爭取社區建設。\n2.為農民爭福利。","unresolved":0},{"document":"bulletin-10-010-080-02","entity":"2022-township-representative:10-010-080-02:8","id":"10-010-080-02-8-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對；公報同頁含鄉長與村長候選人，只轉錄代表第2選舉區欄。政見欄只寫為民服務與爭取地方建設，沒有寫出建設項目，沒有主張","review_status":"未經獨立複評","text":"為民服務，爭取地方建設。","unresolved":0}],"specificity":[{"claim":"10-010-080-02-3-001","criterion":"conditions","evidence":null,"id":"10-010-080-02-3-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-080-02-3-001","criterion":"funding","evidence":null,"id":"10-010-080-02-3-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-080-02-3-001","criterion":"implementation","evidence":null,"id":"10-010-080-02-3-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-010-080-02-3-001","criterion":"instrument","evidence":null,"id":"10-010-080-02-3-001-instrument","level":"un