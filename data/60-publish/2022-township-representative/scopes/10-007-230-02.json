estion_version":1,"reason":"原文「加強弱勢族群照護」的方向與擴大對弱勢者的社會救助相同，但沒有寫出做法，判為支持","review_status":"未經獨立複評","stance":"stance.support","stance_value":1.0}],"ocr":{},"passages":[{"document":"bulletin-10-007-230-02","entity":"2022-township-representative:10-007-230-02:1","id":"10-007-230-02-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見在文字層，依文字層照錄並對照渲染圖逐行核對；十條編號依序轉錄；第10條以名字「武君」自稱，照錄","review_status":"未經獨立複評","text":"1.成立專職鄉民服務處。\n2.配合鄉政、推行政令，監督施政。\n3.美化，綠化，區內環境。\n4.配合區內各宗教團體，施行照顧弱勢族群。\n5.配合區內各社區協會爭取福利。\n6.爭取區民福利，增加老人文康活動及設施。\n7.爭取區內基礎建設。\n8.加強區內居民互動，時常舉辦活動，提昇居民生活品質。\n9.協助區內居民調解民事糾紛。\n10.繼續以行動代表為己任，鄉民的一通電話，武君馬上到府服務。","unresolved":0},{"document":"bulletin-10-007-230-02","entity":"2022-township-representative:10-007-230-02:2","id":"10-007-230-02-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"政見在文字層，依文字層照錄並對照渲染圖逐行核對；五條編號依序轉錄","review_status":"未經獨立複評","text":"1.強化基礎建設、路燈整修、排水疏濬、道路維護。\n2.積極爭取社區關懷據點設立，深化長春照護。\n3.善盡職責、溝通協調，為民服務，為民謀福。\n4.爭取各社區活動中心，設備的充實，提升休閒活動品質。\n5.加強弱勢族群照護，營造安全友善的生活環境。","unresolved":0}],"specificity":[{"claim":"10-007-230-02-1-001","criterion":"conditions","evidence":null,"id":"10-007-230-02-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-230-02-1-001","criterion":"funding","evidence":null,"id":"10-007-230-02-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-230-02-1-001","criterion":"implementation","evidence":null,"id":"10-007-230-02-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-007-230-02-1-001","criterion":"instrument","evidence":"美化，綠化","id":"10-007-230-02-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「美化，綠化」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"10-007-230-02-1-001","criterion":"quantity","evidence":null,"i