lue":1.0},{"allocation":1.0,"claim":"10-009-050-02-2-003","evidence":"發展觀光方向","facet":"regional.tourism","id":"10-009-050-02-2-003-m1","method":"模型判讀","question":"q.regional.tourism","question_version":1,"reason":"原文只寫振興觀光產業的方向或目標，沒有寫出做法，判為支持","review_status":"未經獨立複評","stance":"stance.support","stance_value":1.0}],"ocr":{},"passages":[{"document":"bulletin-10-009-050-02","entity":"2022-township-representative:10-009-050-02:1","id":"10-009-050-02-1-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"整份公報沒有文字層（文字繪成向量外框，政見欄也不是嵌入影像），照 3.8 px/pt 渲染圖（左右兩段）轉錄；六條各一行，第六條折行接回","review_status":"未經獨立複評","text":"一、認真打拼、爭取建設、繁榮地方。\n二、人民請託、服務勤快、完成效率。\n三、監督鎮公所預算編列，不浪費公帑。\n四、提議鎮公所編列預算經費，補助照顧老人福利。\n五、監督土庫鎮興建聯合幼兒園工程施工進度及規格、材料品質。\n六、爭取中央建設經費補助，改善重劃區內農路，因年久破損嚴重，路面柏油需要翻新，以利農民行車安全及保障生命安全。","unresolved":0},{"document":"bulletin-10-009-050-02","entity":"2022-township-representative:10-009-050-02:2","id":"10-009-050-02-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"無文字層，照 3.8 px/pt 渲染圖（左右兩段）轉錄；六條各一行，第六條折行接回","review_status":"未經獨立複評","text":"一、落實福利政策，提升老人福利。\n二、提升兒童教育方向，確實關照教育功能。\n三、認真監督以民意為依歸，創造祥和和樂幸福美滿農村。\n四、全力提升社區綠美化功能、創造優質的生活環境空間。\n五、努力爭取各項建設經費，改善居民生活快樂幸福品質。\n六、落實地方產業，促進年輕人返鄉就業，發展觀光方向，以達成富麗農村、快樂農家的境界。","unresolved":0}],"specificity":[{"claim":"10-009-050-02-1-001","criterion":"conditions","evidence":null,"id":"10-009-050-02-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-009-050-02-1-001","criterion":"funding","evidence":null,"id":"10-009-050-02-1-001-funding","level":"not-applicable","method":"模型判讀","reason":"代表會審查與監督預算不需要另編經費","review_status":"未經獨立複評","value":null},{"claim":"10-009-050-02-1-001","criterion":"implementation","evidence":null,"id":"10-009-050-02-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-009-050-02-1-001","criterion":"instrument","evidence":null,"id":"