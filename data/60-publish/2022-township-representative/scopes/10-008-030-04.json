,"unresolved":0},{"document":"bulletin-10-008-030-04","entity":"2022-township-representative:10-008-030-04:4","id":"10-008-030-04-4-p1","image":null,"method":"模型判讀","ocr_check":null,"page":2,"reason":"政見在文字層，以頁面文字為起點對照渲染圖逐行核對，一致。條目依編號由上而下各占一行。第一條「匡督」（應為監督）為原文錯字，照錄；第五條的引號依文字層字碼寫全形＂。","review_status":"未經獨立複評","text":"一、匡督鎮政，反映民意。\n二、爭取建設，服務地方。\n三、推動社會福利服務，關懷弱勢，落實老人、青少年及幼兒等福利。\n四、協助農民發展精緻農業，促進產業升級，提升市場競爭力。\n五、持續爭取＂草屯鎮鳥嘴潭人工湖工程計畫＂，回饋地方機制。\n六、推動草屯觀光產業，繁榮地方，開創草屯新世紀，邁向美好未來。","unresolved":0},{"document":"bulletin-10-008-030-04","entity":"2022-township-representative:10-008-030-04:5","id":"10-008-030-04-5-p1","image":null,"method":"模型判讀","ocr_check":null,"page":2,"reason":"政見在文字層，以頁面文字為起點對照渲染圖逐行核對，一致。條目依編號由上而下各占一行，編號「一、」後的對齊空白刪除。","review_status":"未經獨立複評","text":"一、認真監督鎮政、爭取地方建設。\n二、推廣地方特色、開拓產銷通路。\n三、推動觀光產業、增加財源收入。\n四、保障農民權益、輔導農產銷路。\n五、關懷弱勢族群、創造祥和社會。","unresolved":0}],"specificity":[{"claim":"10-008-030-04-1-001","criterion":"conditions","evidence":null,"id":"10-008-030-04-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-030-04-1-001","criterion":"funding","evidence":null,"id":"10-008-030-04-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-030-04-1-001","criterion":"implementation","evidence":null,"id":"10-008-030-04-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-030-04-1-001","criterion":"instrument","evidence":null,"id":"10-008-030-04-1-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只寫出目標或方向，沒有寫出採用的措施","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-030-04-1-001","criterion":"quantity","evidence":null,"id":"10-008-030-04-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-008-030-04-1-001","criterion":"schedule","evid