{"claims":[{"end":55,"entity":"2022-township-representative:10-010-170-01:1","fields":{"action":["action.improve"],"beneficiary":["beneficiary.children"],"condition":[],"funding":[],"instrument":[],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.school-facilities"]},"id":"10-010-170-01-1-001","incumbent_plan":false,"method":"模型判讀","passage":"10-010-170-01-1-p1","quote":"關注兒童教育環境","reason":"主張關注兒童的教育環境；比照「提升教育品質與環境」的既有寫法配校舍設施；同句的農民與婦女權利、老人福利另列主張；第一項爭取經費補助提升生活品質、第二項配合公所推動觀光與落實建設沒有寫出項目，第四項是標語，都不建立主張；原文沒有寫出做法","review_status":"未經獨立複評","source_type":"bulletin","start":47},{"end":65,"entity":"2022-township-representative:10-010-170-01:1","fields":{"action":["action.strengthen"],"beneficiary":["beneficiary.farmers","beneficiary.women"],"condition":[],"funding":[],"instrument":[],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.farmer-welfare","target.women-participation"]},"id":"10-010-170-01-1-002","incumbent_plan":false,"method":"模型判讀","passage":"10-010-170-01-1-p1","quote":"重視農民、婦女權利","reason":"主張重視農民與婦女的權利；依既有寫法農民權益配農民福利，婦女權益配女性參與，兩個面向各一半；原文沒有寫出做法","review_status":"未經獨立複評","source_type":"bulletin","start":56},{"end":72,"entity":"2022-township-representative:10-010-170-01:1","fields":{"action":["action.strengthen"],"beneficiary":["beneficiary.elderly"],"condition":[],"funding":[],"instrument":[],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.elderly-security"]},"id":"10-010-170-01-1-003","incumbent_plan":false,"method":"模型判讀","passage":"10-010-170-01-1-p1","quote":"關懷老人福利","reason":"主張關懷長者福利；依既有寫法老人福利配高齡者保障；原文沒有寫出做法","review_status":"未經獨立複評","source_type":"bulletin","start":66},{"end":36,"entity":"2022-township-representative:10-010-170-01:2","fields":{"action":["action.improve"],"beneficiary":[],"condition":[],"funding":[],"instrument":["instrument.public-provision"],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.transport