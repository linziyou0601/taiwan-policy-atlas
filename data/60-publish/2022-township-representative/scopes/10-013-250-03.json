建設","unresolved":0}],"specificity":[{"claim":"10-013-250-03-1-001","criterion":"conditions","evidence":null,"id":"10-013-250-03-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-001","criterion":"funding","evidence":null,"id":"10-013-250-03-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-001","criterion":"implementation","evidence":null,"id":"10-013-250-03-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-001","criterion":"instrument","evidence":"興建","id":"10-013-250-03-1-001-instrument","level":"partial","method":"模型判讀","reason":"原文寫出「興建」，符合部分明示：提出工具名稱或大方向","review_status":"未經獨立複評","value":0.5},{"claim":"10-013-250-03-1-001","criterion":"quantity","evidence":null,"id":"10-013-250-03-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-001","criterion":"schedule","evidence":null,"id":"10-013-250-03-1-001-schedule","level":"unstated","method":"模型判讀","reason":"原文沒有寫出時間安排","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-001","criterion":"target","evidence":null,"id":"10-013-250-03-1-001-target","level":"unstated","method":"模型判讀","reason":"原文沒有指出適用的群體、地域或設施","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-002","criterion":"conditions","evidence":null,"id":"10-013-250-03-1-002-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-002","criterion":"funding","evidence":null,"id":"10-013-250-03-1-002-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-013-250-03-1-002","criterion":"implementation","evidence":null,"id":"1