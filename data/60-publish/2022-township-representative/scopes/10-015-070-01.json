ty":"2022-township-representative:10-015-070-01:5","id":"10-015-070-01-5-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對","review_status":"未經獨立複評","text":"一、關懷弱勢族群，爭取政府對其基本生活更多的照顧。\n二、全力監督鄉政的執行及財源合理支配。\n三、接受鄉民陳情，配合鄉民的需求，積極向上級爭取經費補助。\n四、監督鄉公所加強對本鄉觀光資源的開發、宣導。\n五、監督鄉公所加強本鄉農特產品的研發與推展。","unresolved":0},{"document":"bulletin-10-015-070","entity":"2022-township-representative:10-015-070-01:6","id":"10-015-070-01-6-p1","image":null,"method":"模型判讀","ocr_check":null,"page":1,"reason":"文字層，對照渲染圖逐行核對","review_status":"未經獨立複評","text":"一、爭取地方經費落實其鄉內建設，打造城鄉新風貌。\n二、積極照顧老人、婦女及弱勢團體等社會福利。\n三、竭誠為民服務、善盡職責、為民喉舌。\n四、加強本鄉觀光資源的開發及宣導。\n五、有效率的全力監督公所施政，務求以民意為依歸。","unresolved":0}],"specificity":[{"claim":"10-015-070-01-1-001","criterion":"conditions","evidence":null,"id":"10-015-070-01-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","criterion":"funding","evidence":null,"id":"10-015-070-01-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","criterion":"implementation","evidence":null,"id":"10-015-070-01-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","criterion":"instrument","evidence":null,"id":"10-015-070-01-1-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只寫出目標或方向，沒有寫出採用的措施","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","criterion":"quantity","evidence":null,"id":"10-015-070-01-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","criterion":"schedule","evidence":null,"id":"10-015-070-01-1-001-schedule","level":"unstated","method":"模型判讀","reason":"原文沒有寫出時間安排","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-070-01-1-001","c