":"10-002-050-02-3-p1","quote":"玉田弄獅技藝文化活動","reason":"主張推動玉田的弄獅技藝文化活動；承接第七項的「推動在地性三大社區獨有特色」，傳統民俗的傳承配文化資產","review_status":"未經獨立複評","source_type":"bulletin","start":372},{"end":399,"entity":"2022-township-representative:10-002-050-02:3","fields":{"action":["action.promote"],"beneficiary":[],"condition":[],"funding":[],"instrument":["instrument.public-provision"],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.cultural-heritage"]},"id":"10-002-050-02-3-012","incumbent_plan":false,"method":"模型判讀","passage":"10-002-050-02-3-p1","quote":"二龍競渡百年傳承一系列活動","reason":"主張推動二龍競渡的傳承活動；承接第七項的「推動在地性三大社區獨有特色」，依既有寫法「推廣二龍競渡傳統民俗文化」配文化資產","review_status":"未經獨立複評","source_type":"bulletin","start":386},{"end":418,"entity":"2022-township-representative:10-002-050-02:3","fields":{"action":["action.promote"],"beneficiary":[],"condition":[],"funding":[],"instrument":["instrument.public-provision"],"quantity":[],"schedule":[],"subject":["subject.local-government"],"target":["target.tourism"]},"id":"10-002-050-02-3-013","incumbent_plan":false,"method":"模型判讀","passage":"10-002-050-02-3-p1","quote":"時潮觀光休閒產業蟳蝦祭技術活動","reason":"主張推動時潮的蟳蝦祭觀光休閒活動；承接第七項的「推動在地性三大社區獨有特色」，觀光休閒產業的活動配觀光","review_status":"未經獨立複評","source_type":"bulletin","start":403}],"manifest":{"data_version":"5bc2252e7e37","election":"2022-township-representative","format":"policy-atlas-dataset-scope","format_version":1,"scope":"2022-township-representative:10-002-050-02"},"mappings":[{"allocation":1.0,"claim":"10-002-050-02-3-001","evidence":null,"facet":"economy.fiscal.discipline","id":"10-002-050-02-3-001-m1","method":"模型判讀","question":null,"question_version":null,"reason":"原文只寫「強力監督鄉政預算」，屬於預算的審查與監督，沒有寫出控制支出或減少舉債的方向，不掛題，只計入議題分布","review_status":"未經獨立複評","stance":null,"stance_value":null},{"allocation":0.5,"claim":"10-002-050-02-3-002","evidence":"繼續向鄉公所爭取轉陳權責單位公有閒置土地無償撥用，併提案規劃民休閒娛樂運動場所","facet":"culture.sports","id":"10-002-050-02-3-002-m1","method":"模型判讀","question":"q.culture.sports.participation