unresolved":0},{"document":"bulletin-10-015-110-04","entity":"2022-township-representative-plains-indigenous:10-015-110-04:2","id":"10-015-110-04-2-p1","image":null,"method":"模型判讀","ocr_check":null,"page":2,"reason":"文字層，對照渲染圖核對；第2頁第四選舉區（居住全鄉之平地原住民）；「實劍」照錄原文。政見欄是六項理念，只寫出領域，沒有寫出項目，沒有主張","review_status":"未經獨立複評","text":"一、土地主權是族群命脈的根本。\n二、產業發展是生活永續的基礎。\n三、交通完備是對外拓展的關鍵。\n四、法律知識是鞏固權益的實劍。\n五、人文關懷是部落活力的表現。\n六、資訊網路是連結世界的捷徑。","unresolved":0},{"document":"bulletin-10-015-110-04","entity":"2022-township-representative-plains-indigenous:10-015-110-04:3","id":"10-015-110-04-3-p1","image":null,"method":"模型判讀","ocr_check":null,"page":2,"reason":"文字層，對照渲染圖核對；第2頁第四選舉區（居住全鄉之平地原住民），位於頁面最下一列","review_status":"未經獨立複評","text":"一、傾聽民意，強力問政。\n二、監督鄉政，用心服務鄉民。\n三、督促鄉公所制定社會福利政策，改善族人生活品質。\n四、整合部落傳統文化，結合運動觀光休閒產業及提升鄉民生活環境與就業機會。\n五、整合地方資源，照顧弱勢家庭，重視老弱婦孺福利。\n六、強化社區網絡硬體設備建置多元功能，提升鄉民終生學習力。","unresolved":0}],"specificity":[{"claim":"10-015-110-04-1-001","criterion":"conditions","evidence":null,"id":"10-015-110-04-1-001-conditions","level":"unstated","method":"模型判讀","reason":"原文沒有寫出適用條件、排除對象或替代方案","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-110-04-1-001","criterion":"funding","evidence":null,"id":"10-015-110-04-1-001-funding","level":"unstated","method":"模型判讀","reason":"原文沒有說明經費從哪裡來","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-110-04-1-001","criterion":"implementation","evidence":null,"id":"10-015-110-04-1-001-implementation","level":"unstated","method":"模型判讀","reason":"原文沒有說明由哪個單位、以什麼程序執行","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-110-04-1-001","criterion":"instrument","evidence":null,"id":"10-015-110-04-1-001-instrument","level":"unstated","method":"模型判讀","reason":"原文只寫出目標，沒有寫出採用的措施","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-110-04-1-001","criterion":"quantity","evidence":null,"id":"10-015-110-04-1-001-quantity","level":"unstated","method":"模型判讀","reason":"原文沒有可以核對的數字","review_status":"未經獨立複評","value":0.0},{"claim":"10-015-110-04-1-001","criterion":"sch