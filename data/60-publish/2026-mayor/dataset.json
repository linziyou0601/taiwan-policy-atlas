":[],"facet":"culture.arts","hash":"87dcf0f9c6c06a77db3be0641c2d99d6e4b6cabf9394a0a4c21307708bec883f","id":"q.culture.arts","note":"藝文活動指戲劇、音樂、美術、電影與民俗技藝的展演與體驗，做法包括學校的文化體驗教育、到各地的兒童藝文演出，以及補助藝術展演。","parent":null,"scopes":[],"stem":"政府應增加兒少與民眾參與藝文活動的機會。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.arts.creators","hash":"61c661dc368da49c7658145657fe48553cc3e31cefa865f5bf324b0d373fdf3e","id":"q.culture.arts.creators","note":"包括補助藝文創作者的生活與創作，以及補助民眾參與藝文活動的費用。","parent":null,"scopes":[],"stem":"政府應增加藝文補助。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"culture.arts.creators","hash":"80af485ead86bbac8235d21c412da9129cfb601fc46e816949079aed53545e15","id":"q.culture.arts.creators.youth","note":"包括補助青年購票、參與展演或出國從事藝文活動。","parent":"q.culture.arts.creators","scopes":[],"stem":"政府應補助青年參與藝文活動的費用。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.arts.industry","hash":"6bd21ae6b054b20e88045eb8e46a94fb48b94cb7f70cd3652344ebc2bd31004b","id":"q.culture.arts.industry","note":"藝術產業指藝術作品的創作、展覽、買賣與經紀，例如畫廊與藝術博覽會。","parent":null,"scopes":[],"stem":"政府應以政策扶植藝術產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.budget","hash":"d90dae93d1fe1138594e8756c63be9a4a4a8365d5551a0d4b49e3fe708fbce76","id":"q.culture.budget","note":"文化預算指政府編給文化部與所屬機關的預算。","parent":null,"scopes":[],"stem":"政府應提高文化預算。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.ethnic","hash":"e2e28dd668c3710e2c356c9c48a4a638115d2192c3446bc657806793cc6dfc4b","id":"q.culture.ethnic","note":"族群文化指客家、原住民族、平埔族群、新住民等各族群的祭儀、工藝、飲食、音樂、服飾與傳說等傳統。投入包括文化的調查與保存、傳承活動與展演的經費。","parent":null,"scopes":[],"stem":"政府應增加族群文化保存與發展的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.ethnic.hakka","hash":"3a6c42e06eab0e423839eaca61c6bd88087b207b77f24e531f3cd72cf3402d92","id":"q.culture.ethnic.hakka","note":"客家庄指客家人口集中的鄉鎮與聚落。","parent":null,"scopes":[],"stem":"政府應增加對客家庄產業與文化發展的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.ethnic.indigenous-culture","hash":"590b2510e4141a6911d15d6b9ac108aeb6c4c6e8c9b6049297e88a801dfc8a1e","id":"q.culture.ethnic.indigenous-culture","note":"原住民族文化指各族的傳統與當代文化藝術。投入包括數位典藏與資料庫、博物館與文創園區、展演與競賽、藝文人才的獎勵與培育，以及國際交流。","parent":null,"scopes":[],"stem":"政府應增加原住民族文化保存與推廣的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.ethnic.indigenous-education","hash":"6acb296702d980262b7c9d01317a351a823d40b303764624b434dd64dff7c3d9","id":"q.culture.ethnic.indigenous-education","note":"原住民族教育指依原住民族的語言、文化與傳統知識，為原住民學生辦理的教育。擴充的做法包括制定原住民族學校法、設立原住民族學校與大學、設置輔導原住民族教育與族語教學的團隊、由原住民擔任原住民重點學校的校長與主任，以及改善原鄉學校的教學環境與課程。","parent":null,"scopes":[],"stem":"政府應擴充原住民族教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.ethnic.mainstreaming","hash":"2b91d4410b59229030fef27b5cf25bbf84d2d37f3c2523be8c99456696a86d22","id":"q.culture.ethnic.mainstreaming","note":"族群主流化指政府制定各項政策時，評估政策對客家、原住民族、新住民等不同族群的影響。","parent":null,"scopes":[],"stem":"政府應推動族群主流化，讓各項政策納入不同族群的觀點。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.export","hash":"342d0e61b15defe628f12a3455052c864c823eabd6aa8df64bd0aab4cc14c3d2","id":"q.culture.export","note":"文化內容產業指影視、音樂、出版、遊戲等文化內容的創作與發行產業，補助包括獎勵作品與支持業者。","parent":null,"scopes":[],"stem":"政府應補助文化內容產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.heritage","hash":"ad16d9ee367d49d0746f0a6e57258515f1e6af88d4fa76c279ada3d860d89fce","id":"q.culture.heritage","note":"文化資產指具有歷史與文化價值的古蹟、歷史建築、聚落與文物，保存包括修復、維護與活化再利用。","parent":null,"scopes":[],"stem":"政府應增加文化資產保存的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.language","hash":"23e138c1287104d25ee3c2592396945bc017867485b4ce9c3094434186841f0c","id":"q.culture.language","note":"國家語言指台灣各族群使用的語言與台灣手語，例如原住民族語、台灣台語、客語與馬祖語。","parent":null,"scopes":[],"stem":"政府應加強國家語言的教育與傳承。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.language.indigenous-revitalization","hash":"4b04d0e25fb6e88da8eea2a627e5212a475d22ce8d5eb51a880593bc7aafdba2","id":"q.culture.language.indigenous-revitalization","note":"族語指原住民族的語言，復振指讓族語重新被學習與使用。資源包括族語教材與出版、族語教師與族語推廣人員的人力與待遇，以及部落、教會等地方的族語學習據點。","parent":null,"scopes":[],"stem":"政府應增加族語復振的資源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.sports","hash":"690b746c3e9c18b225f14e071a99b5d092181cb89a38708fe667d1cae914d750","id":"q.culture.sports","note":"體育運動的投入包括推廣全民運動的經費與運動場地，以及扶植運動產業、爭取舉辦國內外運動賽事。","parent":null,"scopes":[],"stem":"政府應增加對體育運動的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"culture.sports.athletes","hash":"8a1498bb8a3c4ecfc14edf742e556a3d0d5885bbfa43cf1e1bdbfc12b371ddf7","id":"q.culture.sports.athletes","note":"競技運動人才指競技選手與運動專業人才。培育包括訓練與參賽補助、從基層到國家代表隊的培訓體系，以及選手的升學管道。","parent":null,"scopes":[],"stem":"政府應增加培育競技運動人才的經費與資源。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"culture.sports","hash":"9626ee8e8ecbac384b8756cb3164b56ab5e68adfb1a7b3bc9f55fa82d9590ef1","id":"q.culture.sports.industry","note":"運動產業指運動用品、運動服務、場館經營與運動賽事等產業，扶植的做法包括設置運動產業園區、媒合企業投資，以及爭取舉辦國內外運動賽事。子題只在你對母題沒有表示不同意時出現。","parent":"q.culture.sports","scopes":[],"stem":"政府應扶植運動產業。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"culture.sports","hash":"44b5756ef4cdb7cd779af1125ce6c55d873508b423a30aa7c74f8eb2a04333e3","id":"q.culture.sports.participation","note":"全民運動指一般民眾參與的運動，投入包括體育預算、運動場地與基層運動團體的補助。子題只在你對母題沒有表示不同意時出現。","parent":"q.culture.sports","scopes":[],"stem":"政府應增加推廣全民運動的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"defense.non-combat-zones","hash":"cfd77170716b86439b232b63c626f3d1303f0922d7b78773ce2520d6ef869be9","id":"q.defense.non-combat-zones","note":"非戰區域指不部署軍事據點與作戰兵力、戰時只提供庇護、談判與人道醫療的地區。作戰設施包括軍事據點與地雷等防禦工事。","parent":null,"scopes":[],"stem":"政府應把城市劃為不部署作戰設施的非戰區域。","version":1},{"budget_share":1.0,"conditions":[],"facet":"defense.personnel.pay","hash":"eaa5deaabec7448f789da05d304845cc0c1177a1887688a96bd035951aa52087","id":"q.defense.personnel.pay","note":"軍人指國軍的志願役官兵。","parent":null,"scopes":[],"stem":"政府應提高軍人的薪資待遇。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.fiscal.discipline","hash":"1ab64496b5ac64e96739506463f9e5702b7b72121bacaf1a6ff81f92449e34c2","id":"q.economy.fiscal.discipline","note":"特別預算指在年度總預算之外，為特定重大事項另外編列的預算，經費常以舉債支應。","parent":null,"scopes":[],"stem":"政府應修法限制舉債與特別預算，控制政府支出。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.fiscal.local-allocation","hash":"a47e3faee05f8479814807a6ec497417aa277415b94fb83dec001d4815a4f62d","id":"q.economy.fiscal.local-allocation","note":"統籌分配款是中央依公式分給地方的稅收，補助款是中央依計畫撥給地方的經費。","parent":null,"scopes":[],"stem":"中央應重新設計對地方的補助款與統籌分配款制度。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry","hash":"04fabdfa60f7527efc6a93f24febefe4ef8478ef9dded3b576aed77ecfe91ec8","id":"q.economy.industry","note":"產業園區指由政府規劃開發、供企業設廠的工業區、科學園區與加工出口區，開發包括新設、擴建與更新既有園區。招商指政府主動邀請國內外企業投資，並協助企業取得用地、水電與處理法規問題。","parent":null,"scopes":[],"stem":"政府應開發產業園區並協助招商，吸引企業投資設廠。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.cooperatives","hash":"142d7177b66a5fc1c4a1a1b5f9fad3a8d8a44b4568a9f223419d17cf3781931e","id":"q.economy.industry.cooperatives","note":"合作社是由成員共同出資、共同經營並分享盈餘的組織，合作社經濟指以合作社為組織形式的經濟活動。","parent":null,"scopes":[],"stem":"政府應扶植合作社經濟。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.digital","hash":"dcc73750c24a98fc5aae517eabcb983f297bc0c0bbb97dd7d24f7e211bff1a7e","id":"q.economy.industry.digital","note":"數位轉型指以數位科技改變產業經營與政府服務的方式，例如公文、訴訟與審理流程的資訊化。","parent":null,"scopes":[],"stem":"政府應以政策推動產業與公共服務的數位轉型。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.finance","hash":"da3f804ae21e6986df72d28630888ed8053d13e60cdd9484a0555e0e48a11acc","id":"q.economy.industry.finance","note":"金融創新指以新技術提供支付、借貸、投資等金融服務，包括金融新創公司。扶植金融產業也包括發展國際金融中心。","parent":null,"scopes":[],"stem":"政府應以政策扶植金融創新與金融產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.foreign-investment","hash":"6643e07d5a8c1015d31b02764e05f0a9aadd405ae248e3e756f361683e11d364","id":"q.economy.industry.foreign-investment","note":"外人投資指外國企業與資金來台設廠或投資，租稅優惠指減免投資應繳的稅。","parent":null,"scopes":[],"stem":"政府應以租稅與政策優惠吸引外國企業與資金來台。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.marine","hash":"27d68ce3ae05cfd3499d6044c6dee1b6b0084e028f21338547eaebdd1e3abd40","id":"q.economy.industry.marine","note":"海洋產業指遊艇、船舶、海運、港埠物流與漁業生技等以海洋為基礎的產業，扶植包括補助、設立產業專區與招商。","parent":null,"scopes":[],"stem":"政府應以政策扶植海洋產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.sme","hash":"5b496a980a1eaf0c1ce68ace0aafe803f6c2413788c6946704892e17f9707426","id":"q.economy.industry.sme","note":"中小企業指資本額或員工人數在一定規模以下的企業，轉型升級指改進產品、技術與經營方式。","parent":null,"scopes":[],"stem":"政府應以資金、技術與人才協助中小企業轉型升級。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.startups","hash":"b6b4bc3559256cc3a3a351fa2331db7d5f38059e7abe6a34002caa93887324dc","id":"q.economy.industry.startups","note":"新創企業指成立不久、以新技術或新模式經營的公司，扶植包括補助、改善天使投資環境、放寬募資規定與設立新創基地。天使投資指個人投資剛起步的公司。","parent":null,"scopes":[],"stem":"政府應以政策扶植新創企業。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"economy.industry.startups","hash":"70625d863b0de8bb16ea63a5e8851e5a7fc5d1fe8f7b03b081c4172b542f1746","id":"q.economy.industry.startups.funding","note":"創業貸款指政府提供或補貼利息、給創業者的貸款，例如青年創業貸款；補助指政府發給創業者的現金補助。增加包括提高貸款額度與補助金額、降低貸款利率，以及放寬申請資格。","parent":"q.economy.industry.startups","scopes":[],"stem":"政府應增加對創業者的貸款與補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.industry.tech","hash":"7d9ace16d172037515d3d5c6a21ae977326606f86b0a9a79468f32e56116acef","id":"q.economy.industry.tech","note":"產業政策指以補助、租稅或公共投資支持特定產業發展。","parent":null,"scopes":[],"stem":"政府應以產業政策扶植半導體、人工智慧等科技產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"economy.public-enterprise","hash":"c391cad66b23929d4999d2d5cf7dced6d8f2923cd03d7aff46e97343dd626e7b","id":"q.economy.public-enterprise.business","note":"公營事業指政府經營或持股超過一半的事業，例如地方政府經營的酒廠。擴大經營包括開發新產品、拓展市場、多角化經營與設立子公司。","parent":null,"scopes":[],"stem":"公營事業應擴大經營的業務與產品。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.bilingual","hash":"64c3d6a4d2dcba75f75c7f992de987fac691d9363d0d01839b1d45044aa326a4","id":"q.education.bilingual","note":"雙語教育指學校以中文與英文進行部分學科的教學，並營造使用英文的校園環境。","parent":null,"scopes":[],"stem":"政府應推動各級學校的雙語教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.character","hash":"70cf78602bae92ff5ba9927c8e48da6550a0a1ff96a6e0db2556e6fa1875cadd","id":"q.education.character","note":"品德教育指培養學生誠實、尊重、負責等品格與道德的教學。","parent":null,"scopes":[],"stem":"政府應加強學校的品德教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.curriculum.english","hash":"d60e1d9716b96b9a0bb9509ea7500d62dd677070c7077b4d18ba4970ad2be1cd","id":"q.education.curriculum.english","note":"課程綱要指十二年國民基本教育課程綱要，規範中小學各科的學習內容。閱讀科學指研究人如何學會閱讀的實證研究，強調依序教導辨識語音與字母拼讀等基礎能力。","parent":null,"scopes":[],"stem":"英文課程綱要應依閱讀科學的實證研究修訂。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.curriculum","hash":"13ddb3e746ca9d798ffa344786fbb64185e99546891929e8b0bb206cc37c8e73","id":"q.education.curriculum.local","note":"鄉土教材指以學校所在縣市或地區的歷史、地理、人物與文化為主題的教材，例如以縣市或流域為名的地方學課程。","parent":null,"scopes":[],"stem":"中小學應在課程中加入在地歷史與文化的鄉土教材。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.digital-skills","hash":"386d8af15c2b00c7cfca28b4dee96579c126e4d2c6305d762ce006342a1f3a1b","id":"q.education.digital-skills","note":"人工智慧教育指教導人工智慧的原理與應用，各年齡層包括在學學生與離開學校的成人。","parent":null,"scopes":[],"stem":"政府應推動各年齡層的人工智慧教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.campuses","hash":"48fab626e2c1f0e92ade3af76c405dacc312a2e1fc98eed941e2b6835e51945a","id":"q.education.higher.campuses","note":"增設指國立大學在原有校地以外設立新的校區，或新設學院，例如在大學較少的縣市設立分校區。","parent":null,"scopes":[],"stem":"政府應增設國立大學的校區與學院。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.financial-aid","hash":"f54766311f632730956c73c08bb24d32156a14d63bca0c953f233b6253f686a0","id":"q.education.higher.financial-aid","note":"學雜費指學生繳交的學費與雜費，全面免除指公私立各級學校都不向學生收取學雜費。","parent":null,"scopes":[],"stem":"政府應全面免除各級學校的學雜費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.financial-aid","hash":"3c7d3f80e19faafcf3c0ea95e64d523866e47a9c46dd5e4f586b1a9125cb96e6","id":"q.education.higher.financial-aid.grants","note":"就學補助指政府發給學生的獎學金、助學金、教育津貼與就學費用補助，包括依身分、成績、表現或家庭經濟狀況發給的項目，例如經濟弱勢、新住民子女與偏鄉學生的補助。擴大包括提高金額與增加名額。","parent":null,"scopes":[],"stem":"政府應擴大學生的就學補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.overseas","hash":"db89d673de06087546a0782a9c820c667fd852b67c4e7c811179d21cbfb81101","id":"q.education.higher.overseas","note":"海外學習包括出國留學、交換學生與海外研習，補助包括獎學金與專門設立的基金。","parent":null,"scopes":[],"stem":"政府應增加學生海外學習的補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.spending","hash":"729d7640fee569590bd6f3eae6ac96ed4c99bd1101f85d5bfb1e5de6621d6c6e","id":"q.education.higher.spending","note":"教育經費指政府編列給各級學校與教育機關的經費。","parent":null,"scopes":[],"stem":"政府應提高教育經費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.spending","hash":"f21e232bb380e52ec23b9b5d2139bf19c03e03add4867dc743636a771e2b0e9f","id":"q.education.higher.spending.rural","note":"偏遠地區學校指位於交通不便、人口較少地區的學校，也稱偏鄉學校，常面臨師資、設備與學習資源不足的問題。增加的教育經費用於這些學校的設備、師資與學習資源。","parent":null,"scopes":[],"stem":"政府應增加偏遠地區學校的教育經費，縮小城鄉的教育差距。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.student-loans","hash":"4d1ff46c598daecb70d3115fa6e3100bc81551924286e204494caaa7b7c65f9d","id":"q.education.higher.student-loans","note":"就學貸款指學生向銀行借款支付學雜費，畢業後一段時間再開始還款，這段時間稱為緩衝期。減輕負擔的做法包括減免利息、延長緩衝期與還款年限，以及放寬緩繳的條件。","parent":null,"scopes":[],"stem":"政府應減輕就學貸款的負擔。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.higher.vocational","hash":"f2892c18fbd95ba489cd22bd07717698f867c91df97c0537bf0a3ac24612bce2","id":"q.education.higher.vocational","note":"技職教育指培養專業技術與職業能力的教育，包括高職、科技大學與技術學院。","parent":null,"scopes":[],"stem":"政府應增加對技職教育的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.international","hash":"b044ab68f83de8ef3df004e00748b53c35ff8836eed4cb43abf381583764adb2","id":"q.education.international","note":"國際教育指讓學生認識其他國家的文化與國際議題的教育，做法包括國際營隊、海外參訪、與外國學校的交流，以及設立推動國際教育的專責單位。","parent":null,"scopes":[],"stem":"政府應擴大各級學校的國際教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.lifelong","hash":"0d720b1ac694efb7c1aa9a0ecb056964a69aa1a387b1183f00f772bb7f8906a3","id":"q.education.lifelong","note":"終身學習指離開學校後繼續學習。公共資源包括社區的免費課程與講座、公共圖書館、終身學習機構，以及提供親職與家庭課程的家庭教育。","parent":null,"scopes":[],"stem":"政府應增加終身學習的公共資源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school","hash":"90f19e4d77f0b1ed4a9ae441d373adade480282fe0302cd063aa30f70606a3d0","id":"q.education.school","note":"校園安全指防範校園內的意外、犯罪與外人入侵，例如門禁、監視設備與校園警衛。","parent":null,"scopes":[],"stem":"政府應增加維護校園安全的預算。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.after-school","hash":"f43ca897f0ddeab69689b4f13420a53db7e98224dd6a7e78d558c894ab20c15a","id":"q.education.school.after-school","note":"課後照顧指國中小學生放學後由學校、社區或民間團體提供的照顧與課業輔導。","parent":null,"scopes":[],"stem":"政府應增加國中小學生課後照顧的服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.bullying","hash":"15f9a7191c90391fe938a4a1ba44b999429d8391ef445c148531618089355876","id":"q.education.school.bullying","note":"校園霸凌指在校園內反覆欺負、排擠或傷害他人的行為，防治包括反霸凌教育、通報與處理程序。","parent":null,"scopes":[],"stem":"政府應加強校園霸凌的防治。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school","hash":"8eaab7a859a3a21a764bdd02216995acdb2608651a1460bfaf4c970bb624c186","id":"q.education.school.class-size","note":"師生比指學生人數與教師人數的比例，降低師生比表示每位教師教導的學生較少，做法包括減少每班的學生人數，即小班教學，以及增加教師員額。","parent":null,"scopes":[],"stem":"政府應降低國中小的師生比。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.compulsory-years","hash":"903dbef0f559c8bd74e8642b8db7249c611bfeab201fc36ead852f8e218f5da3","id":"q.education.school.compulsory-years","note":"義務教育指國民依法應接受的國民教育。2026 年選舉時，《國民教育法》規定 6 歲到 15 歲的國民應受國民教育，共 9 年。延長包括向下延伸到學齡前的幼兒，或向上延伸到高中以上。","parent":null,"scopes":[],"stem":"政府應延長義務教育的年限。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.digital","hash":"007e96f1a0ba82820f0e8f0fa9fd5a383c7e7cb2a458f2a754d0aebe373ff605","id":"q.education.school.digital","note":"智慧校園指以網路、平板電腦與人工智慧等數位科技輔助教學的校園，投入包括更新數位教學設備與校園網路。","parent":null,"scopes":[],"stem":"政府應增加建置智慧校園的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.facilities","hash":"9ccd85724616d441a75ff1374b1914098f9d26373cba8fd4533e29ba75d9d27b","id":"q.education.school.facilities","note":"校舍設施指校舍、操場、廁所與教學設備等學校設施，新建包括增設學校與擴建校舍。子題只在你對母題沒有表示不同意時出現。","parent":null,"scopes":[],"stem":"政府應增加新建與改善校舍設施的經費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school","hash":"539c324ea0089281b7224c68db9683abee31cb662f37e6222684e8f07da2b852","id":"q.education.school.featured","note":"特色教育指學校依在地文化、產業或學生興趣自行設計的課程與專班，例如一校一特色、國高中特色專班與結合社區的課程。","parent":null,"scopes":[],"stem":"政府應推動中小學發展特色教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school","hash":"6d0068b267d475e6bf4b80211fbf7f3480410b7e75dbc8138e511b0921373472","id":"q.education.school.fees","note":"就學費用指學生家庭負擔的學雜費，以及制服、文具與校外教學等費用。減免的做法包括由政府補助一部分或全額負擔。2026 年選舉時，《國民教育法》規定國民小學及國民中學的學生免納學費。","parent":null,"scopes":[],"stem":"政府應減免學生的學雜費與其他就學費用。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.lunch","hash":"9c21f96f8b8cf91bb58780ae3cebe6701aa9346bc811f42a541ddb390d5317e2","id":"q.education.school.lunch","note":"學校午餐指學校供應學生的午餐，增加經費包括減免家長負擔的餐費與提高食材的經費。2026 年選舉時，學校午餐的營養基準與供應組織規定在《學校衛生法》。","parent":null,"scopes":[],"stem":"政府應增加學校午餐的經費，提升午餐品質。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.senior-high-fees","hash":"9dd9c10d13f70fcd1a3d42871b24dfd62c8cc272d6248a34d4bda3044c8bcdac","id":"q.education.school.senior-high-fees","note":"免學費指學生不必繳交學費，雜費與其他費用另計。2026 年選舉時，公私立高級中等學校的學生自 2024 年 2 月起已不必繳交學費，重讀生與私立學校獨立招生入學者除外。","parent":null,"scopes":[],"stem":"高中職應全面免學費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.school.special","hash":"b419ea05ebb13a138ed17c4cac465e0e61062b86583511f2834ee255f3fa54d7","id":"q.education.school.special","note":"特殊教育指為身心障礙與資賦優異學生提供的教育服務。","parent":null,"scopes":[],"stem":"政府應增加特殊教育的人力與預算。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.steam","hash":"1a5fd475c40ecb33efaeca5e4aed3eee3a52d317894fcfc429e02a7d85a30d3b","id":"q.education.steam","note":"STEAM 教育指科學、科技、工程、藝術與數學的跨領域學習，也包括向學生與民眾推廣科學知識的科普教育。","parent":null,"scopes":[],"stem":"政府應加強 STEAM 教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.sustainability","hash":"ebb82a883de09d15258a2047391dde1c6d7f74ad747d861e473f4d1f41356e2f","id":"q.education.sustainability","note":"永續教育指環境與永續發展教育，教導學生認識氣候變遷、資源循環與生態保育，並在生活中實踐節能減碳。","parent":null,"scopes":[],"stem":"政府應加強學校的永續教育。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.teachers.discipline","hash":"96a927b2ae221ad2031740286ed8f8279278265104ed31e8d83a4baa6a5c9a01","id":"q.education.teachers.discipline","note":"教師管教權指教師為維持教學秩序與輔導學生，對學生採取糾正與處置等措施的權限。立法保障指以法律明定管教的範圍、程序與對教師的保障。","parent":null,"scopes":[],"stem":"政府應立法保障教師管教學生的權限。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.teachers","hash":"8bc37c027d7e80ad57af7881b50c8dac0d6d82c0a9755a9d5d54238fce641add","id":"q.education.teachers.rights","note":"教師包括學校的正式教師與代理代課教師。待遇指薪資與津貼，工作權益指聘任的保障、減班時不被裁減與其他勞動條件。","parent":null,"scopes":[],"stem":"政府應改善教師的待遇與工作權益。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.teachers","hash":"09d5e3233c6dfb53bb9082cf0b5eab75cdc9ca2feadc8ac735de16451d74e61e","id":"q.education.teachers.training","note":"師資培育指培養未來教師的課程與名額，例如為偏鄉培育師資。在職進修指在職教師參加研習、增能課程或留職進修。","parent":null,"scopes":[],"stem":"政府應增加師資培育與教師在職進修的資源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"education.teachers.workload","hash":"5c3bcdc5d35ff9896039b391e8b5e0b896346940ed809a9d40aab5312923b646","id":"q.education.teachers.workload","note":"教師行政負擔指教師在教學以外承擔的行政工作，例如處室業務、公文填報、評鑑與活動承辦。減輕的做法包括增聘行政人力與精簡填報作業。","parent":null,"scopes":[],"stem":"政府應減輕教師行政負擔。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.air-quality","hash":"f3be646ed425d49c13f1209e6aeaff46e9e0c112148449b38a39a7c3be844b44","id":"q.environment.air-quality","note":"空氣污染防制指減少粒狀污染物、有害氣體與臭味的排放，對象包括電廠、工廠、車輛、河川揚塵與畜牧場。做法包括訂定更嚴格的排放標準、輔導工廠汰換老舊鍋爐、推廣低污染的交通運具、抑制河川揚塵，以及設置畜牧場的除臭設備。","parent":null,"scopes":[],"stem":"政府應加強空氣污染的防制。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.animal-welfare","hash":"4a47d6d474079ea32620206048c8c80bffa33e265c41ffd82a84c7710fcc4065","id":"q.environment.animal-welfare","note":"動物福利指經濟動物、寵物、實驗動物與野生動物免於不必要的痛苦。公共措施包括加重虐待動物的刑責、動物救援與收容、減少野生動物路殺，以及寵物公園、公共寵物殯葬與寵物醫療保險等寵物友善的設施與服務。","parent":null,"scopes":[],"stem":"政府應擴大動物福利的公共措施。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.carbon","hash":"b38a8048ed85871a948ee91a83301341a5705dfaeb8b03ff9f4eae1a460eea92","id":"q.environment.carbon","note":"交通減碳指減少交通工具排放的二氧化碳。電動運具指以電池供電行駛的電動機車、汽車與公車，燃油交通運具指使用汽油或柴油的汽機車，做法包括購車補助與設置充電樁。","parent":null,"scopes":[],"stem":"政府應推動交通減碳，例如以電動運具取代燃油交通運具。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.carbon.buildings","hash":"be8955c662a318e568e4ed15e042b68ed63f690157c8588c197b9f620cab7a1c","id":"q.environment.carbon.buildings","note":"低碳建築指在興建與使用期間排放較少二氧化碳的建築，例如採用木構造等低碳建材、提高建築的節能效率。推動的做法包括修訂建築法規、獎勵低碳建材，以及標示建築的能源消耗。","parent":null,"scopes":[],"stem":"政府應推動低碳建築，減少建築的碳排放。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.carbon.industry","hash":"4125e642e2542b2787da2abc75a2bd494695de7f61afd50ff5f7bb35f7ee7e3e","id":"q.environment.carbon.industry","note":"產業轉型指產業改用低碳的製程與能源，淨零排放指排放量與吸收量相抵為零。","parent":null,"scopes":[],"stem":"政府應輔導產業轉型到淨零排放。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.carbon.pricing","hash":"a2503004b41ff639ed4c22e6009a253f3d5dd788b20f86b14e640b433674f012","id":"q.environment.carbon.pricing","note":"這類做法稱為碳定價，指以碳費、碳稅或排放交易讓排放者為排放付費。","parent":null,"scopes":[],"stem":"政府應對碳排放收費或課稅。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.carbon.targets","hash":"de908d2f36409a3c84ee6f6b4a034ea01a5c5116d7292ef4709ebc3ef86bfc95","id":"q.environment.carbon.targets","note":"淨零排放指排放量與吸收量相抵為零。","parent":null,"scopes":[],"stem":"政府應訂定分階段的減碳目標，在 2050 年達到淨零排放。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.circular","hash":"ade95231d8f1ba62cde345734f066ac4dd7ea2ed3ccbf8fd8975f85f1def7b5e","id":"q.environment.circular","note":"循環經濟指在生產與消費中減少廢棄物，把廢棄物回收、再製成原料或產品，例如把農業廢棄物製成肥料或飼料。","parent":null,"scopes":[],"stem":"政府應推動循環經濟，把廢棄物轉為可再利用的資源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.circular","hash":"4a06558596b885a44ef55fc359dbe1f7ac9e2c0dd0c0c6c00183e421af3de367","id":"q.environment.circular.pay-as-you-throw","note":"隨袋徵收指民眾購買專用垃圾袋丟垃圾，垃圾處理費依丟棄的垃圾量計算，資源回收物免費收運，用來鼓勵垃圾減量與資源回收。另一種做法是隨自來水費徵收，費用與丟棄的垃圾量無關。2026 年選舉時，臺北市與新北市採用隨袋徵收，其他縣市多隨水費徵收。","parent":null,"scopes":[],"stem":"政府應以隨袋徵收的方式收取垃圾處理費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.circular","hash":"94cb4767a845beda0c8615fc676e509734272d891f86d25d9338426ae446daca","id":"q.environment.circular.waste-facilities","note":"廢棄物處理設施指處理一般垃圾與事業廢棄物的設施，例如垃圾焚化廠、固體再生燃料廠與水泥窯協同處理。焚化廠燒掉垃圾以減少體積，燃燒的熱能可以發電，周邊居民常擔心空氣污染與健康風險。增設指興建新廠或增加既有廠的焚化爐，既有設施在原有規模內的汰舊更新不屬於增設。","parent":null,"scopes":[],"stem":"政府應增設垃圾焚化廠等廢棄物處理設施，提高縣市內的垃圾處理量。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.climate-adaptation","hash":"5c8a59191d64f586501ec2a80286f0a16142dae36dcfd0eeb442e4111a7fd29b","id":"q.environment.climate-adaptation","note":"氣候調適指因應氣候變遷帶來的高溫、暴雨與乾旱等衝擊，調整城市與生活環境。都市降溫的做法例如增加綠蔭、留設通風廊道與保留水域。","parent":null,"scopes":[],"stem":"政府應推動都市降溫等氣候調適的措施。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.conservation","hash":"8508fba71005823259c802daa4a2589b58d92fc375bae78383db3a6f1c82682b","id":"q.environment.conservation","note":"生態保育指保護海岸、沙灘與森林等自然環境與其中的動植物，做法包括監督開發案的環境影響評估，以及復育受開發破壞的環境。環境影響評估指開發前評估開發對環境的影響。","parent":null,"scopes":[],"stem":"政府應加強生態保育，減少開發對自然環境的影響。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.grid","hash":"74ccb15544adc24a89ceffe2c74e0b421843b291622df60bc1d0d9efcf730052","id":"q.environment.grid","note":"電網指輸電與配電網路，更新包括建置智慧電網與儲能設施。","parent":null,"scopes":[],"stem":"政府應加速更新電網。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.noise","hash":"188a03d73d84343726ad55144c62a3a74cf3f07945b4a2c92a65c4cf3700f616","id":"q.environment.noise.enforcement","note":"噪音的稽查與取締指檢測並處罰超過管制標準的噪音，對象包括改裝車輛、娛樂場所、工廠與營建工程。做法包括增設聲音照相等科技執法設備、在噪音熱點常駐稽查與提高稽查頻率。科技執法指以自動偵測設備取得違規證據後舉發。","parent":null,"scopes":[],"stem":"政府應加強噪音的稽查與取締。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.nuclear","hash":"a8ddf9e579a94e59fb3b5435df76cf39107b2f2d29dcf99e7b8763024bab7027","id":"q.environment.nuclear","note":"2026 年選舉時，核一廠、核二廠與核三廠的機組都已停止運轉，核四廠封存。","parent":null,"scopes":[],"stem":"核能發電應作為台灣的電力來源之一。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.nuclear.compensation","hash":"9a63ca58000ba8bb44f28d0a5a9bc950310245f109de18b2690ba238ee5fd3e0","id":"q.environment.nuclear.compensation","note":"核電廠周邊指核電廠所在地與鄰近的鄉鎮。補償指以專法規定對象、項目與金額，補償居民因核電廠建廠、運轉與貯存用過核子燃料而受損的權益。","parent":null,"scopes":[],"stem":"政府應立法補償核電廠周邊居民的權益損失。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.renewable-siting","hash":"5adeb18bbcb9109fca748b2b13fe28d33a994e19c42122fd2361d04a9666f520","id":"q.environment.renewable-siting","note":"綠能案場指太陽光電、風力等再生能源的發電場址。管制包括限制可以設置的區位、管制總設置量、訂定生態門檻與定期稽查。","parent":null,"scopes":[],"stem":"政府應加強綠能案場設置的管制。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.renewables","hash":"2994897fab7d0e313c6f857cbbd0ee6ccf248f67ec09e0f395d41c848eed17c1","id":"q.environment.renewables","note":"再生能源指太陽能、風力、地熱等可以自然補充的能源。","parent":null,"scopes":[],"stem":"政府應擴大發展太陽能、風力等再生能源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.sanitation","hash":"0b0e8cedaeaac7e9f841ad04ea9be79dc7170532cc3d345555119f5ec64c51f2","id":"q.environment.sanitation","note":"環境清潔指垃圾清運、街道、海岸與公共廁所的清潔維護。人力與設備包括清潔隊的員額、垃圾清運的時段與公共廁所的設施。","parent":null,"scopes":[],"stem":"政府應增加環境清潔的人力與設備。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.water","hash":"a171ae19faf53baf122e3e64884aba19573f6385a917b9868f42831e7a07d09b","id":"q.environment.water","note":"河川整治包括疏浚河道、興建污水下水道與處理廢水以改善水質，以及復育河川生態。","parent":null,"scopes":[],"stem":"政府應增加河川流域整治的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"environment.water-supply","hash":"f88268d94794fb931e60384e6cd15932af564cec2273cb1f25034c7ca7bc8957","id":"q.environment.water-supply","note":"投入包括水庫清淤、興建海水淡化廠與再生水廠，以及檢驗自來水的水質。","parent":null,"scopes":[],"stem":"政府應增加穩定供水的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.agency","hash":"146b18d623cfd1a04f09fd60b3f9a43a79c663bbb14807f1dda8a941fdd321a2","id":"q.family.agency","note":"專責委員會指由行政院統籌各部會的組織，負責少子化與人口結構變化的對策。","parent":null,"scopes":[],"stem":"行政院應成立統籌人口政策的專責委員會。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.allowance","hash":"adff3c3e442278e434548426435c604b1bafe438dded3833d0a1bba98452260d","id":"q.family.allowance","note":"現金補助包括生育補助、育兒津貼與相關的租稅減免。","parent":null,"scopes":[],"stem":"政府應增加對育兒家庭的現金補助。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"family.allowance.birth-grant","hash":"a3c5ae3cfa941b2db4ad6ad14906ca7878edf08463e7798c7ba10b6083c9a070","id":"q.family.allowance.birth-grant","note":"指懷孕或生產時一次領取的補助金。","parent":"q.family.allowance","scopes":[],"stem":"政府應提高懷孕與生育時的一次性補助。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"family.allowance.care-allowance","hash":"35b1d21eed7e5a2b83a945d5d44a796049d3ac635873058a2f1cc3da69c1a7e9","id":"q.family.allowance.care-allowance","note":"指不使用公共托育、由家人照顧或送私立托育的家庭。","parent":"q.family.allowance","scopes":[],"stem":"自行照顧幼兒的家庭也應每月領取育兒津貼。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"family.allowance.extend-age","hash":"7622d45e1c811d905f778be9d1fd805b71775f8b936850cf3075dd362c087e79","id":"q.family.allowance.extend-age","note":"子題問津貼的發放年齡，只在你對母題沒有表示不同意時出現。","parent":"q.family.allowance","scopes":[],"stem":"育兒津貼的發放年齡應延長到 12 歲。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare","hash":"893f1dcbea26e8fcd0d5fc505d6609d32c09ae8268f82419854770471b2dc8f5","id":"q.family.childcare","note":"托育服務指托嬰中心、幼兒園與居家保母對 0 到 6 歲幼兒的照顧。公共投入包括補助家長的托育費用、增加幼兒教保的經費，以及鼓勵設立托育設施。","parent":null,"scopes":[],"stem":"政府應增加托育服務的公共投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare.extended-hours","hash":"107eea10ca3700bfc9a882a91e6dc1c8b395da9e59d189471295b128054d7cc0","id":"q.family.childcare.extended-hours","note":"延長托育指托嬰中心或幼兒園在一般時段之後繼續照顧。","parent":null,"scopes":[],"stem":"政府應提供平日延長托育與假日托育服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare.fee-free","hash":"94c9f4f621192ceeb692f308b3fbe2298fd6e98e5bef2d03e463d6d028d63215","id":"q.family.childcare.fee-free","note":"準公共化指政府與私立業者簽約，由政府補助、家長付較低費用的托育。","parent":null,"scopes":[],"stem":"公立與準公共化的托嬰中心和幼兒園應免收月費。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"family.childcare","hash":"681bb9ceae46e8b9bbec3c2c7a8b7af15a6876245c9c5039407a3f850bb48252","id":"q.family.childcare.fee-subsidy","note":"托育費用指家長負擔的托嬰中心、幼兒園或居家保母月費，補助用於降低家長的負擔。子題只在你對母題沒有表示不同意時出現。","parent":"q.family.childcare","scopes":[],"stem":"政府應提高托育費用的補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare.parenting-centers","hash":"28c964ab8b4867babcf068bab6441ca7a99d8b14915a394688455c2acc1736f6","id":"q.family.childcare.parenting-centers","note":"育兒支持據點提供親子活動與育兒諮詢，也讓全職照顧孩子的家長參與社會活動。","parent":null,"scopes":[],"stem":"政府應普設育兒支持據點。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare.public-supply","hash":"06b8eb01724bd9569be71c5ba24c394029db488853b02fa25a58dbf35de6293b","id":"q.family.childcare.public-supply","note":"公共化托育包括公立與準公共化的托嬰中心和幼兒園。準公共化指政府與私立業者簽約，由政府補助、家長付較低費用的托育。","parent":null,"scopes":[],"stem":"政府應增加公共化托育的名額。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.childcare.regulation","hash":"5b26b53436f5c3033cf08074246ae5ae47e641196f7a7f980ee84461b08a7270","id":"q.family.childcare.regulation","note":"托育服務指托嬰中心與幼兒園的服務，監督管理包括制定托育服務專法、定期稽查與處罰違規業者。","parent":null,"scopes":[],"stem":"政府應加強對托育服務的監督管理。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.leave","hash":"f5364e8a7f0bb93457acff046abc51d0999d7d74c8c724b25f5243a299cce9c0","id":"q.family.leave","note":"育嬰留職停薪津貼是勞工請育嬰假、暫停工作期間，由就業保險按月發給的津貼。","parent":null,"scopes":[],"stem":"政府應提高育嬰留職停薪津貼。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.marriage","hash":"7d57ebafa373bb11aea7edc49086f7fd23b8bb120947248d620588eb306f3f21","id":"q.family.marriage","note":"無息貸款指借款不必付利息，利息由政府負擔，借款人只需償還本金。","parent":null,"scopes":[],"stem":"政府應提供青年結婚的無息貸款。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.postpartum","hash":"dc34dff046a048f59b05f6b485783b852d8a908b710fcc4276b60b897cdd4a06","id":"q.family.postpartum","note":"產後照護指產婦生產後的休養與照顧，俗稱坐月子，例如產後護理之家、到宅照顧產婦與新生兒的月嫂，以及產後護理家訪。公共的服務包括由政府自辦，或補助產婦使用這些服務。","parent":null,"scopes":[],"stem":"政府應提供公共的產後照護服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.reproduction.egg-freezing","hash":"c438f57c1d99eb6b2a65c3be9f75fb17e56e1dce986d7ad384e933f0481c8593","id":"q.family.reproduction.egg-freezing","note":"凍卵指取出卵子冷凍保存，供日後生育使用。降低門檻包括補助凍卵的費用，以及放寬使用凍卵生育的資格限制。2026 年選舉時，《人工生殖法》規定醫療機構只能為夫妻實施人工生殖。","parent":null,"scopes":[],"stem":"政府應降低女性凍卵與使用凍卵的門檻。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"family.reproduction.egg-freezing","hash":"074c5de2baff9d899abc918fa1bdf31a23cde5ba8af377aa74301444120166b9","id":"q.family.reproduction.egg-freezing.subsidy","note":"凍卵指取出卵子冷凍保存，供日後生育使用。子題只在你對母題沒有表示不同意時出現。","parent":"q.family.reproduction.egg-freezing","scopes":[],"stem":"政府應補助女性凍卵的費用。","version":1},{"budget_share":1.0,"conditions":[],"facet":"family.reproduction.infertility","hash":"6dd5c7d1e670493b672773242559b64d4b741ae100d92544b686fb6a03f81a01","id":"q.family.reproduction.infertility","note":"不孕症治療包括人工授精與試管嬰兒療程，費用補助指政府負擔部分療程費用。","parent":null,"scopes":[],"stem":"政府應提高不孕症治療的費用補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.accountability","hash":"f78bd65d88cb999cf586dbf5c86ab8249b688b0e112cb5e70d85f14d7a79deb8","id":"q.governance.accountability","note":"法律責任包括民事賠償與刑事處罰，也包括主管對下屬違法失職的連帶責任。","parent":null,"scopes":[],"stem":"政府應加重公務員違法失職的法律責任。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.application-procedures","hash":"d4a3df65d1eeb7eefd63d71aab108378276004e077c782d2cd5a82b262071ae5","id":"q.governance.application-procedures","note":"申辦程序指民眾向行政機關申請證照、補助與福利時要準備的文件、經過的步驟與審核流程。簡化的做法例如減少應備文件、合併申辦窗口與縮短審核時間。","parent":null,"scopes":[],"stem":"政府應簡化民眾申辦案件與申請補助的程序。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.indigenous-land.traditional-territory","hash":"47006d7af2b361e301d9a43e8f538cba9980183ccc4852ff31f995a02cfef5d3","id":"q.governance.indigenous-land.traditional-territory","note":"傳統領域指原住民族依傳統習俗居住、耕作、狩獵與祭祀的土地，例如部落所在地、獵場、耕地與聖地。加強保障的做法包括調查與劃設傳統領域、把土地歸還原住民族，以及由原住民族與政府共同管理。","parent":null,"scopes":[],"stem":"政府應加強保障原住民族的傳統領域權利。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.indigenous.autonomy","hash":"4fc0b4197f2e950948128d677d8e203ea56c5c63e24f9a2b8373e3f5603f4f22","id":"q.governance.indigenous.autonomy","note":"原住民族自治指原住民族自行管理族內的公共事務，制度包括自治區、民族議會與部落公法人。《原住民族基本法》規定原住民族自治另以法律定之，2026 年選舉時沒有這部法律。","parent":null,"scopes":[],"stem":"政府應制定原住民族自治法，實施原住民族自治。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.indigenous.budget","hash":"991048c6804f56c4d8647fd59c3c9251666412030ef63c9ad359df1d35043c72","id":"q.governance.indigenous.budget","note":"原住民族事務的預算指中央與地方政府用於原住民族的社會福利、教育、文化、產業與部落建設等事務的經費。","parent":null,"scopes":[],"stem":"政府應增加原住民族事務的預算。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.indigenous.political-participation","hash":"764be9e55d84aedfdc5d67085b5a5b8dd6f452bfb63170e57331e200046d06fb","id":"q.governance.indigenous.political-participation.local","note":"參與地方決策的參政管道指原住民在地方政府的委員會、諮詢會議與調解委員會擔任委員或代表，以及參與地方政策討論的機會。","parent":null,"scopes":[],"stem":"地方政府應擴大原住民參與地方決策的參政管道。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.indigenous.transitional-justice","hash":"817ecd5ed4cbd808d97ac7954bf2b9f6eae68e6309611f2ba210da35256d07e9","id":"q.governance.indigenous.transitional-justice","note":"原住民族轉型正義指調查並處理過去國家造成的原住民族土地流失、歷史迫害與人權侵害，做法包括以法律設立具調查權的專責機構、設立土地法庭、歸還祖先遺骨與補償。2026 年選舉時，總統府的原住民族歷史正義與轉型正義委員會已在 2024 年完成階段性任務，政策執行由行政院原住民族基本法推動會接續。","parent":null,"scopes":[],"stem":"政府應推動原住民族轉型正義。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.local","hash":"996618d531803b61f71a9b8e0519eaca4733587ce15135568057cb8cd5973e01","id":"q.governance.local.council-transparency","note":"地方議會指縣市議會與鄉鎮市民代表會。議事過程指大會與委員會的開會、發言與表決，公開的做法包括會議直播、即時上網公布會議紀錄與逐字稿。議員經費指議員的助理費、建議款與出國考察等公費支出，公開的做法包括公布助理名冊與支出明細。","parent":null,"scopes":[],"stem":"地方議會應擴大公開議事過程與議員經費的資訊。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.local","hash":"b76ab96e52ab5fd98d7646be11e9e45d58135d9c4d75b64af655e669b720bbf7","id":"q.governance.local.fiscal-autonomy","note":"地方自治指直轄市與縣市依法自行處理地方事務，財政自主指地方政府能自行籌措與運用財源，較少依賴中央補助。","parent":null,"scopes":[],"stem":"政府應擴大地方政府的自治權限與財政自主。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.local.regional-governance","hash":"6a6f82f4b0bebabd7cd8c4d98556e1e594a43c2c26be36065a844e396f6bc090","id":"q.governance.local.regional-governance","note":"區域治理平台指相鄰縣市共同規劃交通、產業與防災等跨縣市事務的協調機制。","parent":null,"scopes":[],"stem":"政府應建立跨縣市的區域治理平台。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.open-government","hash":"d780a7845c10becbc256a656d3668b230685612543756a369e122cb126709f16","id":"q.governance.open-government","note":"開放政府指公開施政資訊並讓民眾參與監督，例如公開預算書、採購資料與國會議事紀錄，以及舉辦座談會蒐集民意。","parent":null,"scopes":[],"stem":"政府應擴大推動開放政府。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.referendum","hash":"6fc8c776a2249f078390ba11c2729b07b10b9d597f4e7fe45d5435ff5c0511c8","id":"q.governance.referendum.threshold","note":"公民投票的門檻指提案與連署所需的人數，以及通過所需的票數。2026 年選舉時，《公民投票法》規定全國性公民投票的提案人數須達最近一次總統選舉選舉人總數的萬分之一，連署人數須達百分之一點五，通過須同意票多於不同意票，且同意票達投票權人總額的四分之一。","parent":null,"scopes":[],"stem":"政府應降低公民投票的門檻。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.transitional-justice","hash":"bab953a4c40cd3f6d7103e297d4c28fcd735c43e0577ad932410bbddfad0afd7","id":"q.governance.transitional-justice","note":"轉型正義指處理威權統治時期的政治迫害與遺留問題，例如調查歷史真相、處理威權象徵、相關修法與設置專責機構。","parent":null,"scopes":[],"stem":"政府應擴大推動轉型正義。","version":1},{"budget_share":1.0,"conditions":[],"facet":"governance.youth","hash":"20341b7e4323a4465d8aa8445d7481c66f4c66fe317f2aaf001a458f4e1ce572","id":"q.governance.youth","note":"專門制度包括制定青年基本法、成立青年事務的專責部會，以及讓青年參與公共決策的機制，例如召開青年國是會議。2026 年選舉時，《青年基本法》已在 2026 年 1 月 21 日公布施行，青年事務在中央由教育部主管，教育部依《教育部青年發展署組織法》設有青年發展署。","parent":null,"scopes":[],"stem":"政府應建立推動青年事務的專門制度。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.cancer","hash":"c294074f266519278102b1403aa6b23e4caac9d98c22495660f6c3535f2859a3","id":"q.health.cancer","note":"癌症新藥補助指由全民健保給付或政府經費支應癌症新藥的藥費，擴大包括增加給付的藥品與適用的病人。","parent":null,"scopes":[],"stem":"政府應擴大癌症新藥補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.children","hash":"d9329caa2b0a29c190c3679361530830b67c375360089cf8bad412fd1920dd2f","id":"q.health.children","note":"兒少醫療指兒童與青少年的醫療照顧，包括發展與身心健康的醫療。","parent":null,"scopes":[],"stem":"政府應加強兒少醫療。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.elderly","hash":"d23a59386a9761b511daa9c66ee5a1c76199c8843b0d219d861c13c3a17a828a","id":"q.health.elderly","note":"高齡醫療指以長者為對象的醫療服務。友善就醫環境例如無障礙設施、陪同就醫，以及讓長者在同一次門診看多個科別的整合門診。","parent":null,"scopes":[],"stem":"政府應加強高齡者的醫療資源與友善就醫環境。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.emergency","hash":"5563f99ac9cf664da9c2d0b9165676fcb304e5c2e6f879ede443c830257da5d0","id":"q.health.emergency","note":"自動體外心臟去顫器（AED）是在心跳驟停時由旁人操作、以電擊恢復心律的急救設備。急救訓練指教導民眾心肺復甦術（CPR）與 AED 的使用。","parent":null,"scopes":[],"stem":"政府應普及社區與公共場所的自動體外心臟去顫器與急救訓練。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.facilities","hash":"e2441398adad26d4c19bd421b00bfc3fcf913dc18927a050c5b693ea0bf772e8","id":"q.health.facilities","note":"醫療園區指集中設置醫院、研究與照護機構的區域。","parent":null,"scopes":[],"stem":"政府應增設醫院與醫療園區。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.food-safety.monitoring","hash":"5b08d9386c0dce8d159c7b3f15f7e721bc16a7fc6f5f8840c4f8a8978e7b555d","id":"q.health.food-safety.monitoring","note":"監測與檢驗包括食品的抽驗、監控制度，以及海洋魚類與海域放射性物質的檢測。","parent":null,"scopes":[],"stem":"政府應加強食品安全的監測與檢驗。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.mental","hash":"89a654c1eb78cfbaef92634eac93a685d309883aee25d304759f2ec810aead10","id":"q.health.mental","note":"心理健康服務指心理諮商、輔導與自殺防治等支持方案。","parent":null,"scopes":[],"stem":"政府應擴大心理健康服務，例如補助諮商與加強校園心理輔導。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.patient-rights","hash":"065eb3d9cf9bcb2e865fd776a8e4d78eee6a4fe71a47efb587d7489cd91ffdcd","id":"q.health.patient-rights","note":"病人權益指病人就醫時的權利，例如知情同意、自主決定是否接受治療、免於不當或過度的醫療，以及向醫院申訴的管道。加強保障的做法例如設立受理病人申訴的病人權益保障委員會、查核醫院不當的醫療行為。","parent":null,"scopes":[],"stem":"政府應加強病人權益的保障。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.premium","hash":"f9d34f84e6c2751cebbfc18c4d748eae4f853bc9f3034e4668ea8e22fd751541","id":"q.health.premium","note":"健保費指全民健康保險的保險費。2026 年選舉時，《全民健康保險法》規定保險費依被保險人的身分，由本人、雇主與政府按比例分擔。","parent":null,"scopes":[],"stem":"政府應減免民眾的健保費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.prevention","hash":"d8960fc8217a960d2b8908f5423ad2993a83cd6a2935b200bdaac42b4afd2197","id":"q.health.prevention","note":"預防保健服務指在發病前或懷孕期間提供的檢查，例如癌症篩檢與產前檢查。擴大補助指增加政府補助的檢查項目，或放寬可以接受補助的年齡與條件。","parent":null,"scopes":[],"stem":"政府應擴大預防保健服務的補助項目與對象。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"health.prevention","hash":"855b3a4fe0bf0f53ea81ab22820c954b05aa4a5f96ab457676e60a67f142894f","id":"q.health.prevention.cancer-screening","note":"癌症篩檢指對沒有症狀的民眾檢查是否罹癌，例如乳房攝影。2026 年選舉時，政府補助 40 到 74 歲婦女每 2 年 1 次乳房攝影檢查。","parent":"q.health.prevention","scopes":[],"stem":"政府應擴大癌症篩檢的補助對象。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.rural","hash":"11af85ce2a212e94c104a64f753e82be94a14254b6a2845f9c67007ed55589cf","id":"q.health.rural","note":"原鄉醫療資源指原鄉與偏鄉的衛生所、醫療設備與醫護人力，也包括就醫與緊急後送的交通。","parent":null,"scopes":[],"stem":"政府應增加原鄉醫療資源。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.telemedicine","hash":"2f064c6c63e1e4e98e6b294d1c8b26beb6355659378155eedd81fda93215e519","id":"q.health.telemedicine","note":"遠距醫療指醫師透過視訊等通訊方式，為不在同一地點的病人看診。","parent":null,"scopes":[],"stem":"政府應擴大遠距醫療服務，例如視訊看診。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.vaccine.publicly-funded","hash":"08fdafee66d2dee2c83c78ed1d5ada3bce411f08ab5f5097ad2bb61cf6bbf0d3","id":"q.health.vaccine.publicly-funded","note":"公費疫苗指由政府出資、民眾免費接種的疫苗。","parent":null,"scopes":[],"stem":"政府應擴大公費疫苗的種類與對象。","version":1},{"budget_share":1.0,"conditions":[],"facet":"health.workforce.pay","hash":"58fa2f57bb3384e672847e9943d71901aa54ec7f91c176180020ae0dc4f365f2","id":"q.health.workforce.pay","note":"醫護待遇指醫師、藥師、護理師等醫事與護理人員的薪資與工時等勞動條件。","parent":null,"scopes":[],"stem":"政府應提高醫護待遇。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.accessibility","hash":"4ee265495afe82d394aba134f3e994de4d4bca78d0873b826c302188e17b6c08","id":"q.housing.accessibility","note":"老舊公寓電梯指在沒有電梯的多層公寓增設電梯或升降機。無障礙環境指讓行動不便者能自行進出與使用的設施，例如坡道與扶手。","parent":null,"scopes":[],"stem":"政府應擴大補助老舊公寓增設電梯與無障礙環境。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.finance","hash":"0169af844cb27d32f46fbd0b2f8ee411713d3d1b8c189f05443d74e2f3eaa438","id":"q.housing.finance","note":"貸款優惠包括降低頭期款、延長貸款期限與補貼利息，修繕住宅指整修老舊住宅的結構、設備與外觀。","parent":null,"scopes":[],"stem":"政府應以貸款優惠或補貼協助民眾購屋與修繕住宅。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"housing.finance","hash":"a09815804b886e21c1f15e6e9d76f1507d2579984f7af1d269640c0c414a40ad","id":"q.housing.finance.purchase","note":"購屋貸款優惠包括降低頭期款、延長貸款期限與補貼利息。","parent":"q.housing.finance","scopes":[],"stem":"政府應以購屋貸款優惠或補貼協助民眾購屋。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.rent","hash":"eca635dc8c432ae888b336418277e2b844fa66216fceee9bddf9ea85b49da2e2","id":"q.housing.rent","note":"協助租屋者的做法例如減輕租金負擔、推動青年與長者同住的青銀共居，以及保障租約、押金、修繕與租金爭議等方面的權益。","parent":null,"scopes":[],"stem":"政府應擴大對租屋者的協助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.rent.subsidy","hash":"c4e624cad739d002741cb3af34ea78fdac43b6c8769002c68496e707f1979d62","id":"q.housing.rent.subsidy","note":"租金補貼指政府按月補助租屋者部分租金。","parent":null,"scopes":[],"stem":"政府應擴大租金補貼的戶數。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.safety","hash":"4975ff03d11a08291c01cf23971e4ca9c92b2314a1cb94005bd9c0cc332c520c","id":"q.housing.safety","note":"建築安全指建築與住宅的結構安全，管理包括補強老舊住宅，以及加重違反建築法的罰則。","parent":null,"scopes":[],"stem":"政府應加強建築安全的管理。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.supply","hash":"34bb25c38e32bf2a02a1c4ebb17f222176c9fffd218c26ee5b36eba6113e0a7a","id":"q.housing.supply","note":"低於市價的住宅例如社會住宅、國民住宅、勞工住宅，以及以容積獎勵換取建商提供的住宅。容積獎勵指允許建築比原本規定多蓋樓地板面積。","parent":null,"scopes":[],"stem":"政府應增加低於市價出租或出售的住宅。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.supply.leasehold","hash":"8784cfdc98d91862df0971681b0dc7a64b8ec9e0a01e4201b4527a702ac29ee4","id":"q.housing.supply.leasehold","note":"地上權住宅指購屋者只取得房屋與一定年限的土地使用權，土地仍屬政府。","parent":null,"scopes":[],"stem":"政府應在公有土地上興建地上權住宅，以低於市價出售。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.supply.public-housing","hash":"067266b4b2f15bed6f6a6eb09908ecdac40b88d36a715de5a8e9cf88b64167a5","id":"q.housing.supply.public-housing","note":"國民住宅指政府興建、以低於市價出售的住宅。2026 年選舉時，《國民住宅條例》已在 2015 年廢止，《住宅法》規定社會住宅只租不售。","parent":null,"scopes":[],"stem":"政府應恢復興建國民住宅。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.supply.social","hash":"97c39ac214f274cf5f9bef0363ea1bc5693f98f94d0e5e3d5582bd2b35a639cd","id":"q.housing.supply.social","note":"社會住宅指由政府興辦或獎勵民間興辦、專供出租的住宅。增加投入包括增加社會住宅的戶數、降低租金，以及擴大優先入住的對象與名額。","parent":null,"scopes":[],"stem":"政府應增加對社會住宅的投入。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"housing.supply","hash":"21a9886d36ec8aacc432e66d26e541ad5b0265f14352616a3406bb3b69a2bbe0","id":"q.housing.supply.youth","note":"做法例如以容積獎勵換取建商提供青年居住的住宅，或由政府把住宅免費提供給新婚青年。容積獎勵指允許建築比原本規定多蓋樓地板面積。","parent":"q.housing.supply","scopes":[],"stem":"政府應增加提供給青年的住宅。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.tax","hash":"6582bf66a1335613000893c969af422f4bb1b17739bf402eb7880d29a9832ec5","id":"q.housing.tax","note":"自住房屋指本人、配偶或直系親屬實際居住，而且沒有出租或供營業的住家用房屋。2026 年選舉時，《房屋稅條例》規定自住房屋的房屋稅為房屋現值的 1.2%，但本人、配偶及未成年子女於全國僅持有一戶房屋、供自住且房屋現值在一定金額以下者為 1%；財政部另限本人、配偶及未成年子女全國合計三戶以內。","parent":null,"scopes":[],"stem":"政府應減輕自住房屋的房屋稅。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.urban-renewal","hash":"d2c432ab219157beaced6c0e0abda73c48d0cf54f2c268e46fa6d1c4c1b2aa26","id":"q.housing.urban-renewal","note":"都市更新指重建或整建老舊市區的建築與公共設施，危老重建指依《都市危險及老舊建築物加速重建條例》重建危險或老舊的建築。","parent":null,"scopes":[],"stem":"政府應加速推動都市更新與危老重建。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.urban-renewal.incentives","hash":"ba544d1f2f22e7c96f33bd912cab6701f099d9c99675b9c2714b62c67803e3a4","id":"q.housing.urban-renewal.incentives","note":"容積獎勵指重建時允許比原本規定多蓋的樓地板面積，用來提高住戶與建商參與重建的誘因。","parent":null,"scopes":[],"stem":"政府應提高都市更新與危老重建的容積獎勵。","version":1},{"budget_share":1.0,"conditions":[],"facet":"housing.urban-renewal.procedure","hash":"bab8b2ba1a36ee1cc87ee50167dddb8c89eae46ae12267506e655ea2c40e26bf","id":"q.housing.urban-renewal.procedure","note":"都市更新的程序包括取得住戶同意、劃定更新地區，以及政府審議更新計畫。簡化的做法例如縮短審議的時程、降低住戶同意的門檻。","parent":null,"scopes":[],"stem":"政府應簡化都市更新的程序。","version":1},{"budget_share":1.0,"conditions":[],"facet":"international.diplomacy.city","hash":"f603c766defe6926cb069a5cb528d46c2b5f9baba0052e6b84b0fc5a4e83af72","id":"q.international.diplomacy.city","note":"城市外交指地方政府與外國城市締結姊妹市或友誼城市、參加國際城市論壇與城市網絡，以及進行文化、觀光與教育的交流。","parent":null,"scopes":[],"stem":"地方政府應擴大城市外交。","version":1},{"budget_share":1.0,"conditions":[],"facet":"international.trade.export-promotion","hash":"642dbf224575a7bcb1b98df5b143db8ba38880fa54117c6a7caf8783fd49d492","id":"q.international.trade.export-promotion","note":"外銷市場指國外的銷售市場與通路，協助的做法例如建立外銷的產銷平台、提供國際市場資訊與行銷協助。","parent":null,"scopes":[],"stem":"政府應協助拓展農漁產品的外銷市場。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.corruption","hash":"71ace106efa88e84ac7c4b2741841f6001472272390e49c3782429ece44a10aa","id":"q.justice.corruption","note":"貪腐弊案指公務員利用職務收受賄賂、圖利他人或侵占公款等案件，追查包括清查特定領域的預算與採購。","parent":null,"scopes":[],"stem":"政府應投入更多資源追查貪腐弊案。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.fraud.enforcement","hash":"b6f799afad3d35afa44ea392eabc1ace6766666abb176b0ae7bee1000a0e7eea","id":"q.justice.fraud.enforcement","note":"查緝做法包括成立專責機關、沒收犯罪所得與阻斷詐騙金流。","parent":null,"scopes":[],"stem":"政府應投入更多資源查緝詐騙犯罪。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.gambling","hash":"a4dafca573574557b2217b9acd677bc02e6459a27ddb324525bd08c697938f0a","id":"q.justice.gambling","note":"2026 年選舉時，刑法處罰在公共場所或公眾得出入的場所賭博財物，《離島建設條例》只允許離島經地方公民投票同意後設置觀光賭場。放寬例如在台灣本島設置觀光賭場，或讓麻將等娛樂不再適用賭博罪。","parent":null,"scopes":[],"stem":"政府應放寬賭博的法律限制。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.judicial.trial","hash":"000b9a8f5f16e5005e3f2b40401c8512aa8bed2476d4795d5212d62787d04db8","id":"q.justice.judicial.trial","note":"審判制度包括審判是否公開、人民是否參與審判、證據規則、法官迴避、冤案平反，以及行政訴訟與審判職務的國家賠償。","parent":null,"scopes":[],"stem":"政府應修法改革法院的審判制度。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"justice.judicial.trial","hash":"b384426adee93c331508f9a60d1ebd8521ecfc0dbf66fff996ddd004fa316dbf","id":"q.justice.judicial.trial.jury","note":"2026 年選舉時，《國民法官法》自 2023 年起施行，由國民法官與職業法官共同審判部分重大刑事案件，沒有採用陪審制。","parent":"q.justice.judicial.trial","scopes":[],"stem":"刑事審判應改採陪審制，由人民組成的陪審團決定被告是否有罪。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.legal-aid","hash":"0ab5408ad36447a98ce7618cf07cc82ee81e1c54b9b6110370b0af547b056b37","id":"q.justice.legal-aid","note":"法律扶助指法律諮詢與訴訟協助。管道例如為詐騙受害者提供集體訴訟的法律扶助，或引進律師在勝訴後才從賠償中收取報酬的制度，讓民眾不必先付律師費。集體訴訟指多名受害者共同對同一加害者起訴求償。","parent":null,"scopes":[],"stem":"政府應擴大民眾以免費或低費用取得法律扶助的管道。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.organized-crime","hash":"f4c525f5640e35ea576fbca3c82b8e4a6d6ac8bd1fcead2d7c017633074085ce","id":"q.justice.organized-crime","note":"黑金指黑道勢力與金錢介入政治與公共事務，槍毒指非法槍械與毒品。","parent":null,"scopes":[],"stem":"政府應加強查緝黑金與槍毒犯罪。","version":1},{"budget_share":1.0,"conditions":[],"facet":"justice.policing","hash":"1a05b12fab08dd4fb45870d63211ce415bf94ebf85a743aa98ad0ac58ce343a7","id":"q.justice.policing","note":"治安維護指警察巡邏、社區守望、監視器與科技執法等預防與查緝犯罪的做法。","parent":null,"scopes":[],"stem":"政府應增加治安維護的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.civil-service-pay","hash":"962df6e78a5003790ba281ad83ea827a77ac873c3cd8126af2539b24d488ab8a","id":"q.labor.civil-service-pay","note":"公教待遇指公務人員與公立學校教職員的薪資與加給。","parent":null,"scopes":[],"stem":"政府應調高公教待遇。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment","hash":"0571bdf98102fb9ff043e68808362f5de4ab740b3777e9ddc4e3aef64bbfa0c0","id":"q.labor.employment","note":"勞動權益指工時、休假、工資與職業安全等勞動條件，修法指修改《勞動基準法》等勞動法規。","parent":null,"scopes":[],"stem":"政府應修法加強勞工的勞動權益保障。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.atypical","hash":"20000852d53b89e2d09052b1adcfe62b49db236d9dbd3e102011ea50f5df6c92","id":"q.labor.employment.atypical.rights","note":"非典型勞工指不是由雇主直接、長期、全時僱用的勞工，例如派遣勞工、臨時人員、部分工時人員，以及受僱於政府委外廠商的勞工。加強保障包括確保如期足額領到薪資、提供保險、設立諮詢與申訴管道，以及處罰違約的廠商。","parent":null,"scopes":[],"stem":"政府應加強保障派遣、臨時與委外等非典型勞工的權益。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.flexible-work","hash":"40060a74abfad9af4f8f100402555a364b047ac1f936f4b2599d934faf67c73c","id":"q.labor.employment.flexible-work","note":"彈性工作安排指員工可以調整上下班時間、縮短每日工時或減少工作日數，以配合照顧子女。2026 年選舉時，《性別平等工作法》規定，受僱於僱用 30 人以上雇主的員工，為撫育未滿 3 歲子女，可以向雇主請求每天減少工作時間 1 小時或調整工作時間。","parent":null,"scopes":[],"stem":"政府應推動企業為育兒員工提供彈性工作安排。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.injury-compensation","hash":"e193440518c8703a5ab4c9c4fc1545c0b93444b5497525efa837ba07e26bf21b","id":"q.labor.employment.injury-compensation","note":"職業災害指勞工因工作受傷、生病或死亡。補償與照顧包括醫療、失能與死亡的給付、撫卹，以及協助受傷勞工復工。","parent":null,"scopes":[],"stem":"政府應提高職業災害勞工的補償與照顧。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.occupational-health","hash":"fbef754357301079312de29af7dd69b974123bdc58acf25e42f6343a93dc7ac3","id":"q.labor.employment.occupational-health","note":"職業安全衛生指預防工作造成的傷害與職業病，做法包括職場安全的檢查、員工的健康檢查與安全衛生教育。","parent":null,"scopes":[],"stem":"政府應加強勞工的職業安全衛生。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.promotion","hash":"725ff8f6a1733c843cf800b478475c1d4ed5c6f418313999cc0bb4a37dc36ac0","id":"q.labor.employment.promotion","note":"就業促進指協助民眾找到工作，例如職業訓練補助、就業媒合、失業者再就業協助與就業獎勵津貼。","parent":null,"scopes":[],"stem":"政府應擴大就業促進的補助與服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.sex-work","hash":"6a0afd4af39e12a684a269abbca0e9f1d0bc01a30306b899bdf714407ca05559","id":"q.labor.employment.sex-work","note":"2026 年選舉時，《社會秩序維護法》處罰性交易，只有在地方政府依自治條例規劃的區域內不處罰。","parent":null,"scopes":[],"stem":"性工作應合法化，並保障性工作者的勞動權益。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.employment.unions","hash":"09eff99656fc42c707e4ee7afb9d848149b5ae2a0282875cba48b77fdf343761","id":"q.labor.employment.unions","note":"2026 年選舉時，《工會法》規定組織工會須有 30 名以上勞工連署發起。","parent":null,"scopes":[],"stem":"政府應降低勞工組織工會的門檻。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.insurance.premium-subsidy","hash":"b8ebb48393aa51061501ae02c5a222736838c5e9ae24fa8f18d75cec5caa7657","id":"q.labor.insurance.premium-subsidy","note":"外勤工作者指外送、保全、業務等經常在外移動工作的勞工，意外傷害保險在發生交通事故等意外時給付醫療與傷害理賠。","parent":null,"scopes":[],"stem":"政府應補助外勤工作者的意外傷害保險費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.public-pension","hash":"0c76f5a7229022dacd38c0939ddc09dc52235ca9db109523e50713438e452b9f","id":"q.labor.public-pension","note":"軍公教指軍人、公務人員與公立學校教師。2026 年選舉時，公務人員的退休給付依 2018 年 7 月 1 日施行的《公務人員退休資遣撫卹法》計算。","parent":null,"scopes":[],"stem":"政府應提高軍公教與警消人員的退休給付。","version":1},{"budget_share":1.0,"conditions":[],"facet":"labor.wage.level","hash":"d9393db15c545e354da1dd9c3426f786f3e2c20e5c3c0dd65ea957c68db3ffd9","id":"q.labor.wage.level","note":"薪資水準指勞工整體的薪資高低，政策包括產業轉型與調整工資的相關規定。","parent":null,"scopes":[],"stem":"政府應以政策提高勞工的整體薪資水準。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.caregivers","hash":"f32c6cab6162e7c1314fa6cd83b919a97021dda146a5e521e0e0990ea70b53ac","id":"q.long-term-care.caregivers","note":"家庭照顧者指在家照顧失能、失智或身心障礙家人的親屬。支援包括發給照顧者津貼、協助照顧者兼顧工作，以及減輕家庭照顧的經濟負擔。","parent":null,"scopes":[],"stem":"政府應增加對家庭照顧者的支援。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"long-term-care.caregivers","hash":"61b06e2f6fa3c6882bc06a9bd972364c626b3c11aaecb73450969171560cb7bb","id":"q.long-term-care.caregivers.allowance","note":"照顧者津貼是政府定期發給家庭照顧者的現金補助。子題只在你對母題沒有表示不同意時出現。","parent":"q.long-term-care.caregivers","scopes":[],"stem":"政府應發給家庭照顧者津貼。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.caregivers.respite","hash":"f19edb2530eba5d18035dea2fc0a275f0e4601d8ad20b46e4d38ab466ee333f9","id":"q.long-term-care.caregivers.respite","note":"喘息服務指由專業人員短期代為照顧，讓家庭照顧者休息。","parent":null,"scopes":[],"stem":"政府應擴大家庭照顧者的喘息服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.community","hash":"255d0d3bdbfeea95aa0361b1827d780251edad8ba9f21ed61d95f078f696e2dd","id":"q.long-term-care.community","note":"長照服務據點指設在社區或部落、為長者提供關懷訪視、共餐、健康促進與日間照顧的場所，例如社區照顧關懷據點與日間關懷站。擴大包括增設據點與增加服務項目。","parent":null,"scopes":[],"stem":"政府應擴大社區與部落的長照服務據點。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.community.home-care","hash":"eded797613c58a938fe3c9c3ded8c9928055539c87a1678bd544d3334aac90b1","id":"q.long-term-care.community.home-care","note":"社區長照包括日間照顧中心與社區據點，居家長照指照顧服務員到家中提供照顧。量能指服務的據點與人次，品質包括以科技輔助照顧、整合看護移工與長照體系，以及照顧不同族群的需求。","parent":null,"scopes":[],"stem":"政府應擴大居家與社區長照服務的量能與品質。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.eligibility","hash":"72d71d284696cccbbd525ab28802757161fcc8fd7e4f4c98de7679e0a59e6544","id":"q.long-term-care.eligibility","note":"巴氏量表是評估日常生活能力的量表，也是申請家庭看護移工的主要門檻。","parent":null,"scopes":[],"stem":"申請長照或看護時，應放寬或免除巴氏量表的失能評估門檻。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.financing.benefit-scope","hash":"8b9f7d2b312584c02a1803224518bcc0fcf6ff78bf58ed3232a330f80d8fa79e","id":"q.long-term-care.financing.benefit-scope","note":"給付範圍指長照制度補助的服務與費用，例如把聘僱外籍看護、入住長照機構與辭職照顧家人的家庭納入給付。","parent":null,"scopes":[],"stem":"政府應擴大長照服務的給付範圍。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.oversight","hash":"2870c82a877bd14bdcabf8166ab70949c1ce6b0f1baa928bdd7482eebed6d912","id":"q.long-term-care.oversight","note":"長照服務單位指提供居家、社區與住宿式長照服務的機構與業者。監督管理包括定期評鑑與查核、公開違規業者的名單，以及長照人員的培訓。","parent":null,"scopes":[],"stem":"政府應加強長照服務單位的監督管理。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.residential","hash":"9316a165fddb6fd414e237ad7d37ebed213a1b72a9844ea0d7d9581c64bc9371","id":"q.long-term-care.residential","note":"住宿式長照機構指提供 24 小時照顧的護理之家與長照機構，投入包括增設機構與補助入住者的費用。","parent":null,"scopes":[],"stem":"政府應增加對住宿式長照的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.workforce","hash":"827ef32367d12b2efb66b0af182c41c08ea9d8513433b2c2fdf8c32bc7f02dc1","id":"q.long-term-care.workforce","note":"照顧服務員指在長照機構、日間照顧中心或到宅照顧失能者的人員，待遇包括薪資與勞動保障。","parent":null,"scopes":[],"stem":"政府應提高照顧服務員的待遇。","version":1},{"budget_share":1.0,"conditions":[],"facet":"long-term-care.workforce","hash":"c028f7bece564c903ea9dc43bb3176fd142ad43211277b1257d69a1dde1bbe89","id":"q.long-term-care.workforce.training","note":"照顧服務員指在長照機構或到家中照顧失能者的人員。職業訓練包括照顧技能的課程與證照輔導，長照人力指提供長期照顧服務的人數。","parent":null,"scopes":[],"stem":"政府應擴大照顧服務員的職業訓練，增加長照人力。","version":1},{"budget_share":1.0,"conditions":[],"facet":"migration.agency","hash":"a6576b14c05425268fd6107d6bf85e5a7fc222b3c80afa59b888b8b4d2fc4056","id":"q.migration.agency","note":"移民委員會指統籌移民與新住民政策的部會層級機關。2026 年選舉時，移民與新住民業務由依《內政部移民署組織法》設立的內政部移民署主管。","parent":null,"scopes":[],"stem":"政府應成立專責新住民與移民事務的移民委員會。","version":1},{"budget_share":1.0,"conditions":[],"facet":"migration.new-residents","hash":"116c84afc27dd49f5d204511fc0d15e0528200c2f640a34b920c2d2644110f2e","id":"q.migration.new-residents","note":"新住民指因婚姻或其他原因移居台灣的外籍與中國大陸人士，福利措施包括生活適應、就業與子女教育的協助。","parent":null,"scopes":[],"stem":"政府應擴大新住民福利的措施與服務。","version":1},{"budget_share":1.0,"conditions":[],"facet":"migration.new-residents.employment","hash":"eadb9c1bb6ffbc464bd1a3e6cf5ea839f2faad785a46a17a877ccd5de21cbc88","id":"q.migration.new-residents.employment","note":"新住民指因婚姻或其他原因移居台灣的外籍與中國大陸人士，就業協助包括職業訓練、就業媒合與防止就業歧視。","parent":null,"scopes":[],"stem":"政府應擴大新住民的就業協助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture","hash":"b95700dc7d99949d7229496ca80bbbabf700773f15dd526d48d7b69c168db322","id":"q.regional.agriculture","note":"補助與輔導包括農漁業的生產設備、技術、行銷與農村建設等方面的協助。","parent":null,"scopes":[],"stem":"政府應增加對農漁業的補助與輔導。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.fishery","hash":"28afa40299c967c3998e09a25f97488b44321e21c7862a32ab716ef2423a341c","id":"q.regional.agriculture.fishery","note":"漁港設施指漁港的碼頭、停泊與作業空間等設施，投入包括興建、改善與擴充。","parent":null,"scopes":[],"stem":"政府應增加漁港設施的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.marketing","hash":"ffd5a9ac75f42d32fac28549323cffdfff0d96addfc3a92e08eb77af590e8cda","id":"q.regional.agriculture.marketing","note":"農產運銷指農產品從產地到消費者的行銷與銷售。協助的做法例如建立農產品品牌、開闢電商等銷售通路，以及完善冷鏈系統。冷鏈指農產品從產地到銷售全程維持低溫的保存與運輸。","parent":null,"scopes":[],"stem":"政府應協助農產品的行銷與銷售通路。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.production","hash":"5a904ae00413d5bb4be797a292f9241ff8d4b8fc8c3006dd3b69cdf5c24c4da1","id":"q.regional.agriculture.production","note":"農業生產設施指農機具、農田灌溉與蓄水等設施。","parent":null,"scopes":[],"stem":"政府應增加農業生產設施的補助與建設。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.rural-regeneration","hash":"89da3c24d88e94516b8079fdb186daa1efd1f5673bcc75f286395a59c4bc8a92","id":"q.regional.agriculture.rural-regeneration","note":"農村再生指改善農村的住宅、公共設施與生產環境。","parent":null,"scopes":[],"stem":"政府應推動農村社區的全面更新。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.technology","hash":"e2fb593b37c113e96a48ba84c51c88439a8c69a7345c1f557ee05613b5f867fe","id":"q.regional.agriculture.technology","note":"智慧農業指以感測器、自動化設備與資料分析等科技管理農業生產。輔導包括補助設備與派員到農村提供技術服務。","parent":null,"scopes":[],"stem":"政府應輔導農民導入智慧農業等農業技術。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.agriculture.welfare","hash":"b1335ba499bbdd027710413b1d75c3f9c8d17701a58a65156c6aa5e5b62e6ce3","id":"q.regional.agriculture.welfare","note":"農民福利包括老農津貼與農民健康保險，退休保障例如建立老農離農退休制度。老農津貼指按月發給老年農民的福利津貼。","parent":null,"scopes":[],"stem":"政府應擴大農民福利與老年農民的退休保障。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.balance","hash":"d8bd1ab4363d4c8af170b64781b8fc86ac575fb98bab14d904d0397a24a29b7d","id":"q.regional.balance","note":"城鄉發展落差指都市與鄉村、不同區域之間在交通、產業、教育與文化等建設與發展的差距，縮小這個落差也稱區域均衡。","parent":null,"scopes":[],"stem":"政府應增加縮小城鄉發展落差的建設投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.expropriation","hash":"00f562f08b7f6fea1ae908104c4fa55019d95c844bdff245e4babd81978ada64","id":"q.regional.expropriation","note":"土地徵收指政府為了興建道路、學校等公共建設，依《土地徵收條例》強制取得私有土地，再依規定發給補償。加強保障的做法包括限縮徵收的範圍、公共建設優先使用公有土地，以及由政府取得長期供公眾通行的私有道路用地，這類道路稱為既成道路。","parent":null,"scopes":[],"stem":"公共建設使用私有土地時，政府應加強保障土地所有權人的權益。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.facility-relocation","hash":"3e4a61165cd5c1cbb0b9a50c87c59859af9ce9255a356bc3d4fb60bb116e40aa","id":"q.regional.facility-relocation","note":"鄰避設施指居民普遍不希望設在住家附近的設施，例如變電所、軍事射擊場與垃圾處理場。遷離聚落指把這類設施移到遠離住宅的地點。","parent":null,"scopes":[],"stem":"政府應把變電所、射擊場等鄰避設施遷離聚落。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.land-use","hash":"8a12cfad16c5043aaf983dcdd94addbfee94599a7dfd346e581713e202af1eee","id":"q.regional.land-use","note":"土地使用管制指都市計畫對土地用途、建築高度與開發的限制，禁建與限建指禁止或限制在特定地區建築。容積率指建築的總樓地板面積與基地面積的比例，容積率越高可以蓋得越多。","parent":null,"scopes":[],"stem":"政府應放寬土地開發與使用管制，例如解除禁建、限建與提高容積率。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.local-compensation","hash":"068f0ca9bd802f4db049d8b1b7e84c49522643dc3d213145877e4e1287fdd164","id":"q.regional.local-compensation","note":"地方回饋指政府或開發者給電廠、綠能案場、道路工程所在地，以及水源保護區等土地受到管制的地區的回饋金、補助或公共建設。","parent":null,"scopes":[],"stem":"政府應增加對設施所在地與土地受管制地區的地方回饋。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.public-land","hash":"840c800bd185281a9a209d089e955093e09892be24c36ede8e3e461299269529","id":"q.regional.public-land","note":"公地放領指政府把公有耕地有償移轉給承租耕作的農民，讓售指把公有土地或台糖公司的土地以價購方式出售給長期使用的人民，例如已在土地上建屋居住的人。","parent":null,"scopes":[],"stem":"政府應擴大把公有土地放領或讓售給長期使用的人民。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.public-works","hash":"1eecda5c5ba98f83093a96ef5043fa5c82eea9146d1abde047b7b596b8336721","id":"q.regional.public-works","note":"公共工程指政府出資興建或維護的道路、管線、建築與公共設施。品質查驗包括施工查核、第三方認證與完工驗收，期程控管指督促工程依預定時程完工。","parent":null,"scopes":[],"stem":"政府應加強公共工程的品質查驗與期程控管。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"regional.public-works","hash":"11e0ec2bfe51f887b631ceaabf9f399e39f33ef86a0ccf4b0d480a60c9617907","id":"q.regional.public-works.road-excavation","note":"道路挖掘指自來水、瓦斯、電力與電信等管線單位為埋設或維修管線而開挖路面。統一管理的做法包括由地方政府統一核准與排定開挖、整合各單位同時施工、預埋共同管道，以及要求開挖後整段路面修復。","parent":"q.regional.public-works","scopes":[],"stem":"政府應統一管理道路挖掘，減少管線單位重複開挖路面。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.relocation","hash":"a73453aba6370483308d38f3e48dd5c16f3f14f50260ba9b72b23d2c8c60a880","id":"q.regional.relocation","note":"遷村指聚落因工業污染、國土保育或開發而整體遷移到其他地點，安置與補償例如搬遷費、安置住宅與土地補償。","parent":null,"scopes":[],"stem":"政府應增加對整體遷村居民的安置與補償。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.revitalization","hash":"c150fcdae95ffdf05af552beac9da63779710dc9eaceee44fe103825a441562e","id":"q.regional.revitalization","note":"地方創生指以在地產業與人才帶動人口回流、促進區域均衡發展的政策。","parent":null,"scopes":[],"stem":"政府應增加地方創生的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.tourism","hash":"5d2fc8b33aa58554ebff4dc54f1ede5fb772533fdf2ab34626ea09bcdb1454ed","id":"q.regional.tourism","note":"振興觀光的政策包括開放更多旅客來台與補助觀光業者。","parent":null,"scopes":[],"stem":"政府應以政策振興觀光產業。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.aviation","hash":"a577b327f25734fdf5d3522339d12d7ea31b8d208c82263a2533dc10532e247b","id":"q.regional.transport.aviation","note":"運輸量能指機場可以起降的航班與服務的旅客人數，擴大的做法例如擴建航廈與跑道。國際航線指往返國外機場的定期航班。","parent":null,"scopes":[],"stem":"政府應擴大機場的運輸量能與國際航線。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.fare-subsidy","hash":"2370911ef1e2d2e5f87ac9f1ff39deb59b910e20849e22cd6d9f8eb48930421c","id":"q.regional.transport.fare-subsidy","note":"交通票價補貼指政府補助部分票價或運費，例如可在一定期間內不限次數搭乘大眾運輸的定期票與月票，以及離島居民搭乘飛機、輪船與以船舶運送車輛的費用。","parent":null,"scopes":[],"stem":"政府應增加大眾運輸與離島交通的票價補貼。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.infrastructure","hash":"ec9c531626bacff8212ff8f90ca7f4f9d2e8d1d67282f5d8f8e8866de8d9e526","id":"q.regional.transport.infrastructure","note":"交通建設指道路、橋梁、隧道、鐵路與機場的興建、拓寬與改善。","parent":null,"scopes":[],"stem":"政府應增加道路、橋梁、隧道與鐵路等交通建設的投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.maritime","hash":"30f7ab4483a025aef4c07c531aa30c3eeb832ef83d76adb23acf580405040726","id":"q.regional.transport.maritime","note":"港埠與海運指商港與交通碼頭，以及客貨輪與渡輪的航線與船班。擴大包括興建與擴建碼頭、新闢航線與增加船班。","parent":null,"scopes":[],"stem":"政府應擴大港埠的建設與海運的船班。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.motorcycle","hash":"7d577f9e1763957b8d633d80f4069485c1f2d5d27d772c3bf9dea73c0e56be1e","id":"q.regional.transport.motorcycle","note":"機車路權指機車可以行駛的車道與轉彎方式。兩段式左轉指機車左轉時先直行到路口的待轉區停等，再隨橫向號誌直行完成左轉。內側車道禁行機車指以標誌或標線禁止機車行駛內側車道。2026 年選舉時，《道路交通安全規則》第 99 條規定機車應依標誌或標線行駛車道，內側車道設有禁行機車標誌或標線的路口，機車應以兩段方式左轉。","parent":null,"scopes":[],"stem":"政府應放寬機車路權的限制，例如取消兩段式左轉與內側車道禁行機車。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.parking","hash":"d9a89dd6398bffa0bff5e8a11c4cf6ad8188e9c08972ded8f9a7f6eedf18bd21","id":"q.regional.transport.parking","note":"停車空間指公有停車場、地下停車場與立體停車場，增建包括利用公園、學校與運動場的地下空間興建停車場。","parent":null,"scopes":[],"stem":"政府應增建停車空間。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.public-transit","hash":"38b16a4fa787855410d9c7ef381d7b52ed3e521176f58548ede4c56a38f1b58f","id":"q.regional.transport.public-transit","note":"大眾運輸指捷運、公車與鐵路客運，擴大包括興建新路線與增加班次。","parent":null,"scopes":[],"stem":"政府應擴大大眾運輸的路網與班次。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.rural-transit","hash":"253668fa7efdec691331179be44674599c2ab352f561d25b0c546eec5e2f8fdf","id":"q.regional.transport.rural-transit","note":"偏鄉公共運輸指原鄉與偏鄉的幸福巴士、就醫計程車補助與緊急叫車等交通服務。","parent":null,"scopes":[],"stem":"政府應擴大偏鄉公共運輸的服務與補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.safety","hash":"89e3d8e72f35a86483f5b26d210b61f52ab247f2a6f25016d2aee5988f34fee2","id":"q.regional.transport.safety","note":"安全措施包括改善道路設計、行人與機車的用路規劃、駕照分級與回訓、車輛安全配備與交通執法。","parent":null,"scopes":[],"stem":"政府應加強交通系統的安全措施。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.transport.shared-vehicles","hash":"820abdd898ce6da298d32093d51d01320a2174964a6b6e41197a49e52a402167","id":"q.regional.transport.shared-vehicles","note":"共享運具指民眾在街頭租借、用完歸還的自行車或機車，例如公共自行車。","parent":null,"scopes":[],"stem":"政府應擴大共享運具的站點與車輛。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.tribal.economy","hash":"01c51905573e581cb16193b0e7f0c1d7482aa3189f1a6967b4ebbfe2b3d34d2d","id":"q.regional.tribal.economy","note":"部落產業指部落的特色農漁產品、藥材、手工藝與文化產業，協助包括補助、產銷輔導、設立販售通路與合作社。","parent":null,"scopes":[],"stem":"政府應增加對部落產業的補助與產銷協助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.tribal.infrastructure","hash":"cfd4e59f1a6b422e89349bff0cb145457bff87a1934c5e368f5b8d1b17fdcd82","id":"q.regional.tribal.infrastructure","note":"部落基礎建設指部落的道路、供水、排水、電力、聚會所與公墓等公共設施。","parent":null,"scopes":[],"stem":"政府應增加部落基礎建設的經費。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.tribal.urban","hash":"ecce1559da9f9e0d47d6c5528b45082bee4f08361dbac84507e02e3a0c9f62f7","id":"q.regional.tribal.urban","note":"都市原住民指居住在原住民族地區以外的原住民。發展包括集會所與祭典場所，以及安居、就學、就業與融資等方案。","parent":null,"scopes":[],"stem":"政府應增加都市原住民發展的經費與設施。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.bikeways","hash":"ede326217054c051182608bc92afa5d209470dfa28401a0216e4871490584b37","id":"q.regional.urban.bikeways","note":"自行車道包括鐵馬道與綠園道，增建包括興建新路線，以及把既有路線串連成路網。","parent":null,"scopes":[],"stem":"政府應增建自行車道。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.commercial-districts","hash":"536029a50e2289591e390902beca5a74a86bf43926e946ff49e6103548cce22c","id":"q.regional.urban.commercial-districts","note":"商圈指店家集中的商業街區，振興包括改造街景、行銷商圈、吸引觀光客與輔導店家。","parent":null,"scopes":[],"stem":"政府應投入資源振興地方商圈。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.greening","hash":"b24a51fd02aa35bcc16edbe2f53ba63b28b79d1645a903d4c8964ac9a841bc0d","id":"q.regional.urban.greening","note":"都市綠化指增加都市的綠地與植栽，例如種植行道樹、設置綠屋頂與生態綠廊，以提高綠覆率。綠覆率是綠地與植栽覆蓋的面積比例。","parent":null,"scopes":[],"stem":"政府應擴大都市綠化。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.public-space","hash":"f799ba3a832e1e837abfd8eaa2742f20669bea6e885c951199cdd4c5bb6d0c7f","id":"q.regional.urban.public-space","note":"公共空間指公園、廣場，以及供親子、藝文、社團與寵物使用的公共場所，增建包括把閒置的公有土地或建物改建成公共空間。","parent":null,"scopes":[],"stem":"政府應增建公園與公共空間。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.service-centers","hash":"dfa2b3c2ad513bae0ed286bdc0f792dd232d1678ffc02241dda8a66b4077d5c5","id":"q.regional.urban.service-centers","note":"政府服務據點指區公所、戶政與地政等機關聯合辦公、就近提供行政服務的行政中心或行政園區。投入包括新設據點與改善既有據點的設施。","parent":null,"scopes":[],"stem":"政府應增加政府服務據點的建設投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.streetscape","hash":"3d6a210634d3d79c247132c2d4b2b0ebab3082362a6bb59e19321208499d64ca","id":"q.regional.urban.streetscape","note":"市容指街道、騎樓、招牌與建築外觀等城市的外觀。整建包括翻新建築立面、整平騎樓與整理招牌。","parent":null,"scopes":[],"stem":"政府應投入經費整建街道與建築立面的市容。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.undergrounding","hash":"272d23877817dde8f90a956abeb211c9d37717107cee9c5d436fff76fba20120","id":"q.regional.urban.undergrounding","note":"電力設施地下化指把架空的電線與地面上的電力設施改設在地下，或遷移到不妨礙通行的位置。","parent":null,"scopes":[],"stem":"政府應加速電力設施地下化，例如電線桿、電箱與高壓電塔。","version":1},{"budget_share":1.0,"conditions":[],"facet":"regional.urban.waterfront","hash":"01775619935477a5efeaf5fda8d815347781d3f5181f3a7d06e62f650fe43f3b","id":"q.regional.urban.waterfront","note":"水岸空間指沿河地區的都市發展與河濱空間，親水休憩設施指河濱公園、划船區等可以接近水域的休閒場所。","parent":null,"scopes":[],"stem":"政府應開發河岸的水岸空間，設置親水休憩設施。","version":1},{"budget_share":1.0,"conditions":[],"facet":"rights.children","hash":"6f9b1ac43146452b097ad1e3ab94e12b5c8d5e12e90044f2ee2680b0bb7d4755","id":"q.rights.children","note":"兒童權利指兒童與少年的生存、受保護與參與等權利。2026 年選舉時，《兒童權利公約施行法》已讓聯合國兒童權利公約具有國內法律的效力。","parent":null,"scopes":[],"stem":"政府應以法律加強兒童權利的保障。","version":1},{"budget_share":1.0,"conditions":[],"facet":"rights.gender.workplace","hash":"89b36e0c01b1ec1a2e75b10ee5823e9c66b63005bbeed28da14db0f0b77e0831","id":"q.rights.gender.workplace","note":"職場平等指性別與育兒友善的職場，就業差距指男女勞動參與率的差距。","parent":null,"scopes":[],"stem":"政府應以政策推動職場平等，縮小男女的就業與薪資差距。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.disaster","hash":"cbf7f1fa06f923d5b8fe4cdf5e1fcb814406e729e64c2ea30bf9531a0a46f759","id":"q.safety.disaster","note":"防救災指揮體系指災害發生前後統籌預防、通報、應變與救援的組織與機制，例如災害應變中心與跨縣市的緊急應變平台。","parent":null,"scopes":[],"stem":"政府應強化防救災指揮體系。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.disaster.digital","hash":"8c4fbccb50a8f0c26af50325b2ceae245f5b23cb287efdcaf3443f802b69b6e2","id":"q.safety.disaster.digital","note":"安全管制平台指以線上系統辦理建築、消防等公共安全的檢查、申報與管理。","parent":null,"scopes":[],"stem":"政府應建置安全管制的數位平台。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.disaster.facilities","hash":"5043d1da638facb58d46c76eb9cc6cd33c0ac60d49f49df6f8b3d6d5714d15d2","id":"q.safety.disaster.facilities","note":"防災設施指災害發生時供民眾使用的公共設施，例如避難場所、防災公園、消防栓與巷弄的滅火器。防災物資指為災害儲備的防災用品與維生物資。","parent":null,"scopes":[],"stem":"政府應增設供民眾使用的防災設施與防災物資。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.firefighters.duties","hash":"7516f5d2c7077fdf73c08f600a177b7d8f111ee548efdaebdfe76c82785129df","id":"q.safety.firefighters.duties","note":"包括減少警察協辦其他機關的業務、專注治安與交通勤務，以及讓消防人員在危險的救災現場可以依情況撤退，稱為退避權。","parent":null,"scopes":[],"stem":"政府應減輕警察與消防人員的勤務負擔與執勤風險。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.firefighters.welfare","hash":"6b2a2bcf84c426412036824c4738183b1478ddd876c41dd536eae02273f6bd21","id":"q.safety.firefighters.welfare","note":"警消待遇指警察與消防人員的編制、裝備、訓練、退休制度與因公傷亡的照顧。","parent":null,"scopes":[],"stem":"政府應改善警消待遇。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.flood-control","hash":"a0c13f5f185d96852f28ff2f5edb78e4424001db36e12fe921ec4eafa3039cdd","id":"q.safety.flood-control","note":"防洪排水設施指區域排水、截水溝與雨水下水道等防範淹水的設施。","parent":null,"scopes":[],"stem":"政府應增加防洪排水設施的建設。","version":1},{"budget_share":1.0,"conditions":[],"facet":"safety.geological","hash":"e18c213a88746d0828e4805972b4850faf0d0ad11d4f06e516cbdfcdd7ea21a4","id":"q.safety.geological","note":"地質災害指山崩、土石流、地層下陷與天坑等與地質有關的災害，防治包括地質調查、治山防災工程與工程規範。天坑指地面因地下掏空而突然塌陷形成的坑洞，地層下陷指地面逐漸下沉。","parent":null,"scopes":[],"stem":"政府應加強地質災害的調查與防治。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.allowance","hash":"692161c8716790bebf826538396685ed005f5e9f367f1408651346ad0a166bb7","id":"q.welfare.allowance","note":"生活津貼指政府依身分按月發給的補助，例如身心障礙者生活補助與中低收入老人生活津貼。擴大包括提高金額、放寬資格與新增發給的對象。","parent":null,"scopes":[],"stem":"政府應擴大按月發給的生活津貼。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.assistance.eligibility","hash":"0b05045b294438dd64905b84cae1f88b4f09be8e6504c4bdb0f019c77b503e5e","id":"q.welfare.assistance.eligibility","note":"中低收入認定指政府依家庭收入與財產認定低收入戶與中低收入戶，通過認定的家庭可以領取補助。","parent":null,"scopes":[],"stem":"政府應放寬中低收入認定的資格。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.assistance.safety-net","hash":"729cd70e8072a708f19c6e766a2124a1b8ad56a3d7de964e10ef6b7d725e55f8","id":"q.welfare.assistance.safety-net","note":"社會安全網指政府整合社會福利、衛生、警政與教育體系，協助高風險家庭與保護個案的服務。","parent":null,"scopes":[],"stem":"政府應擴大社會安全網的服務量能。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.assistance.support","hash":"4727fd9e9cbebb8c27e79fb3829d7dd926240d353739f96d121507d333541c68","id":"q.welfare.assistance.support","note":"社會救助指政府對生活困難者提供的生活扶助、安置與急難救助，弱勢者包括無家者、失智長者與經濟困難的家庭。","parent":null,"scopes":[],"stem":"政府應擴大對弱勢者的社會救助。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"welfare.assistance.support","hash":"8115a29f4aa02be457b47a7e459c2d2dc6be03c59c43f07e886bb8dcc713f366","id":"q.welfare.assistance.support.resident-insurance","note":"居民團體保險指政府為轄內全體居民投保的團體意外或醫療保險，居民不必自付保費。擴大包括新開辦、增加保險項目與提高保險金額。子題只在你對母題沒有表示不同意時出現。","parent":"q.welfare.assistance.support","scopes":[],"stem":"政府應擴大為轄內居民投保的團體保險。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.basic-income","hash":"f0187d9268051c48aeb32efa87f090db81176a8c54ba666db177dcb194645d9e","id":"q.welfare.basic-income","note":"無條件基本收入指不論收入與工作狀況，政府定期發給每個人相同金額的現金。","parent":null,"scopes":[],"stem":"政府應實施無條件基本收入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.disability","hash":"9a5cb4ff0fcb847300c0034baa6803fdcc7bb1e37bb35d313a5c7077a4962f41","id":"q.welfare.disability","note":"身心障礙福利指提供給領有身心障礙證明者的生活補助、輔具補助、照顧與就業協助。","parent":null,"scopes":[],"stem":"政府應擴大身心障礙福利。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.disaster-relief","hash":"bedd6de65943a9f0f5b135efa258e51d55dfe4c28204e55c9dd423d0298f508d","id":"q.welfare.disaster-relief","note":"受災民眾指受颱風、地震、水災等天然災害或疫情衝擊的居民與農漁民。救助與紓困指政府直接發給的現金或補助，擴大包括提高金額、放寬發給的對象，以及簡化申請與災損提報的程序。","parent":null,"scopes":[],"stem":"政府應擴大對受災民眾的救助與紓困。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.funeral","hash":"2a3559c80dba212dd839618143404aaf3eb9935c80bd5c211773aa85af3c07bf","id":"q.welfare.funeral","note":"殯葬服務指殯儀館、火化場、納骨塔與公墓等設施，以及喪葬費用的補助。公共投入包括興建與改善公立殯葬設施、減免使用費用與補助喪葬費。","parent":null,"scopes":[],"stem":"政府應增加對殯葬服務的公共投入。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.national-pension","hash":"229a2674e22dd6d76beb5d7b840eb8843a0eea22ad4646e7a5210c5ae48baba7","id":"q.welfare.national-pension","note":"國民年金是沒有參加其他社會保險的 25 歲到 65 歲國民參加的年金保險，給付包括老年年金、身心障礙年金與遺屬年金。","parent":null,"scopes":[],"stem":"政府應調高國民年金給付。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.senior","hash":"37beed6bf97e7da4cc8569340207c1403339f6540ebb7cf0cc8ae4900f353290","id":"q.welfare.senior","note":"長者福利包括依年齡給長者的敬老優待與現金補助，以及保障長者健康的福利措施。關懷服務指對獨居長者的定期訪視與關懷。","parent":null,"scopes":[],"stem":"政府應擴大給長者的福利與關懷服務。","version":1},{"budget_share":0.5,"conditions":["neutral","agree","strongly-agree"],"facet":"welfare.senior","hash":"e394575c42168b70ef59f1d74304bca0a2f1f177698978df06ec47d5b0fd4d8a","id":"q.welfare.senior.benefits","note":"敬老優待與補助指政府依年齡給長者的優待與現金補助，例如敬老卡的乘車補助、假牙補助與節日發給的敬老金。子題只在你對母題沒有表示不同意時出現。","parent":"q.welfare.senior","scopes":[],"stem":"政府應擴大給長者的敬老優待與補助。","version":1},{"budget_share":1.0,"conditions":[],"facet":"welfare.universal-payment","hash":"1ff24a9490747ade6ae4a5a9e877feb3bd7fe6dd14da8ac54973aa7fe9238138","id":"q.welfare.universal-payment","note":"普發指不論身分與收入，發給每位居民相同金額的現金或消費券，例如振興券。普發是一次、逢年節或每年的發放，與按月發給每個人的基本收入不同，也不以災害或疫情為發放的前提。","parent":null,"scopes":[],"stem":"政府應普發現金或消費券給全體居民。","version":1}],"scopes":[{"areas":[],"county":"09007","has_policy_data":true,"id":"2026-mayor:09-007","name":"連江縣","towns":[]},{"areas":[],"county":"09020","has_policy_data":true,"id":"2026-mayor:09-020","name":"金門縣","towns":[]},{"areas":[],"county":"10002","has_policy_data":true,"id":"2026-mayor:10-002","name":"宜蘭縣","towns":[]},{"areas":[],"county":"10004","has_policy_data":true,"id":"2026-mayor:10-004","name":"新竹縣","towns":[]},{"areas":[],"county":"10005","has_policy_data":true,"id":"2026-mayor:10-005","name":"苗栗縣","towns":[]},{"areas":[],"county":"10007","has_policy_data":true,"id":"2026-mayor:10-007","name":"彰化縣","towns":[]},{"areas":[],"county":"10008","has_policy_data":true,"id":"2026-mayor:10-008","name":"南投縣","towns":[]},{"areas":[],"county":"10009","has_policy_data":true,